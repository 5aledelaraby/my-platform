{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "content/**"],
  "envMode": "loose",
  "tasks": {
    "typecheck": {
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "env": ["DEPLOY_ENV"],
      "outputs": ["dist/**"]
    }
  }
}
