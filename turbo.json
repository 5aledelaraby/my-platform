{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "content/**"
  ],
  "envMode": "loose",
  "tasks": {
    "transit": {
      "dependsOn": [
        "^transit"
      ]
    },
    "typecheck": {
      "dependsOn": [
        "transit"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "DEPLOY_ENV",
        "PUBLIC_API_URL"
      ],
      "outputs": [
        "dist/**"
      ]
    }
  }
}
