# Response headers for the static site (Cloudflare Workers static assets).
# Kept minimal on purpose: no script/style CSP, because Astro may inline small scripts and styles.

# Strict-Transport-Security: HTTPS only on this hostname (no includeSubDomains/preload: those cannot be undone quickly).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# Astro build output: file names contain a content hash, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photos, films, fonts and the logo keep their names when they are replaced, so they are cached for a while (not
# forever): pages load faster from one to the next, and a new photo shows up within the hour.
/img/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/video/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/fonts/*
  Cache-Control: public, max-age=2592000
