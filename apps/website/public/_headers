# Response headers for the static site (Cloudflare Workers static assets).
# Kept minimal on purpose: no script/style CSP, because Astro may inline small scripts and styles.

# Strict-Transport-Security: HTTPS only on this hostname (no includeSubDomains/preload: those cannot be undone quickly).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# Astro build output: file names contain a content hash, so they never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Photos, films and the logo as the pages link them (scripts/fingerprint.mjs): the address carries a hash of the
# file, so a replaced file gets a new address and these can be cached for a year.
/v/*
  Cache-Control: public, max-age=31536000, immutable

# The same files at their plain address (cart script, og:image, outside links) keep their names when they are
# replaced, so they are cached for a while (not forever), and a new photo shows up there within the hour.
/img/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/video/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=604800
/brand/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/fonts/*
  Cache-Control: public, max-age=2592000

# Staging is never indexed, whatever build it serves (production and staging may share this Worker after cutover).
https://staging.vicuna-eg.com/*
  X-Robots-Tag: noindex, nofollow
