---
import { canonicalUrl, robotsDirective } from "@platform/seo";
import type { DeployEnvironment } from "@platform/seo";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Cart from "../components/Cart.astro";
import type { Lang } from "../site.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Site-relative path of the same page in the other language, e.g. "/en/". */
  altPath?: string;
  /** Optional JSON-LD, already serialized with serializeJsonLd. */
  jsonLd?: string;
  /** Pages that must never be indexed even in production (thank-you page). */
  noindex?: boolean;
  /** Social preview image, site-relative. Defaults to the brand photo. */
  image?: string;
}

const { title, description, lang = "ar", altPath, jsonLd, noindex = false, image = "/img/hero-1200.webp" } = Astro.props;

// Only the production build may be indexed (ADR 0005). Set DEPLOY_ENV=staging|preview on non-production deployments.
const env = (import.meta.env.DEPLOY_ENV ?? "production") as DeployEnvironment;
const site = Astro.site!.toString();
const canonical = canonicalUrl(site, Astro.url.pathname);
const alt = altPath ? canonicalUrl(site, altPath) : undefined;
const ogImage = new URL(image, site).toString();
const arUrl = lang === "ar" ? canonical : alt;
const enUrl = lang === "en" ? canonical : alt;
const switchHref = altPath ?? (lang === "ar" ? "/en/" : "/");
---

<!doctype html>
<html lang={lang} dir={lang === "ar" ? "rtl" : "ltr"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : robotsDirective(env)} />
    <link rel="canonical" href={canonical} />
    {arUrl && <link rel="alternate" hreflang="ar" href={arUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    <link rel="alternate" hreflang="x-default" href={arUrl ?? canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:locale" content={lang === "ar" ? "ar_EG" : "en_US"} />
    <link rel="preload" href={lang === "ar" ? "/fonts/cairo-arabic-400-normal.woff2" : "/fonts/cairo-latin-400-normal.woff2"} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lang === "ar" ? "/fonts/el-messiri-arabic-700-normal.woff2" : "/fonts/el-messiri-latin-700-normal.woff2"} as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="skip" href="#main">{lang === "ar" ? "تخطَّ إلى المحتوى" : "Skip to content"}</a>
    <Header lang={lang} altHref={switchHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <Cart lang={lang} />
  </body>
</html>
