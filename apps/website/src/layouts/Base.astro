---
import { SHIPPING, formatEgp } from "@platform/commerce";
import { canonicalUrl, robotsDirective } from "@platform/seo";
import { deployEnvironment } from "../deploy-env.ts";
import Header from "../components/Header.astro";
import Consent from "../components/Consent.astro";
import Footer from "../components/Footer.astro";
import Cart from "../components/Cart.astro";
import HowToBuy from "../components/HowToBuy.astro";
import { langPath, otherLanguagePath } from "../site.ts";
import type { Lang } from "../site.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Optional JSON-LD, already serialized with serializeJsonLd. */
  jsonLd?: string;
  /** Pages that must never be indexed even in production (thank-you page). */
  noindex?: boolean;
  /** Social preview image, site-relative. Defaults to the lace white photo (owner, 2026-10-19). */
  image?: string;
  /** The largest image on the first screen, fetched first and at high priority (with its srcset when it has one). */
  lcpImage?: string;
  lcpSrcset?: string;
  /** The header sits on the first photo (home page). */
  overlayHeader?: boolean;
  /** Shows the small "how to order" tip after a while (store pages: home, belts, designs, products). */
  howto?: boolean;
  /** The same page in each language, this page included (journal articles that have a translation). */
  alternates?: readonly { lang: Lang; href: string }[];
}

const { title, description, lang = "en", jsonLd, noindex = false, image = "/img/looks/lace-white-1200.webp", lcpImage, lcpSrcset, overlayHeader = false, howto = false, alternates: given = [] } = Astro.props;

// Only the production build may be indexed (ADR 0005). DEPLOY_ENV is required at build time (see deploy-env.ts).
const env = deployEnvironment();
const site = Astro.site!.toString();
const canonical = canonicalUrl(site, Astro.url.pathname);
const ogImage = new URL(image, site).toString();
const ar = lang === "ar";
// The store pages exist in English (root) and Arabic (/ar/): each declares the other as its alternate (hreflang, both
// ways), except pages that stay out of search. Journal guides pass their own pair; other pages have none.
const pair = otherLanguagePath(Astro.url.pathname);
const alternates = given.length > 0 || !pair || noindex ? given : [{ lang, href: Astro.url.pathname }, { lang: pair.lang, href: pair.path }];
// Where the language switch leads: the same page in the other language, else the other language's home page.
const otherLang: Lang = ar ? "en" : "ar";
const switchHref = given.find((a) => a.lang === otherLang)?.href ?? pair?.path ?? langPath(otherLang, "/");
const announce = ar ? `شحن مجاني من ${formatEgp(SHIPPING.freeOver)} جنيه` : `Free shipping from EGP ${formatEgp(SHIPPING.freeOver)}`;
---

<!doctype html>
<html lang={lang} dir={lang === "ar" ? "rtl" : "ltr"} data-track={env === "production" ? undefined : "off"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : robotsDirective(env)} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, site).toString()} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL((alternates.find((a) => a.lang === "en") ?? alternates[0]!).href, site).toString()} />}
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:locale" content={lang === "ar" ? "ar_EG" : "en_US"} />
    {lcpImage && <link rel="preload" href={lcpImage} imagesrcset={lcpSrcset} imagesizes={lcpSrcset ? "100vw" : undefined} as="image" type="image/webp" fetchpriority="high" />}
    <link rel="preload" href="/fonts/poppins-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    {lang === "ar" && <link rel="preload" href="/fonts/ibm-plex-sans-arabic-arabic-400-normal.woff2" as="font" type="font/woff2" crossorigin />}
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {/* Browsers that support it fetch a page in the background as soon as a finger or the mouse rests on its link,
        so opening it feels instant. Prefetch only (no prerender): no page runs before it is really opened. */}
    <script type="speculationrules" set:html={JSON.stringify({ prefetch: [{ where: { and: [{ href_matches: "/*" }, { not: { href_matches: "/api/*" } }] }, eagerness: "moderate" }] })} />
  </head>
  <body>
    <a class="skip" href="#main">{lang === "ar" ? "تخطَّ إلى المحتوى" : "Skip to content"}</a>
    <Consent lang={lang} />
    <div class="announce"><p>{announce}</p></div>
    <Header lang={lang} overlay={overlayHeader} switchHref={switchHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} switchHref={switchHref} />
    <Cart lang={lang} />
    {howto && <HowToBuy lang={lang} />}
    <button type="button" class="to-top" data-to-top aria-label={ar ? "الرجوع لأعلى الصفحة" : "Back to top"}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" /></svg>
    </button>
    <script>
      // Cards fade up as they come into view, and the back-to-top button appears once the visitor has scrolled down
      // more than a screen. Nothing here measures the layout while the page loads (PageSpeed "forced reflow").
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const items = document.querySelectorAll(".reveal");
      if (!calm && "IntersectionObserver" in window) {
        document.documentElement.classList.add("reveal-ready");
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -6% 0px" },
        );
        items.forEach((el) => io.observe(el));
      }
      const toTop = document.querySelector<HTMLButtonElement>("[data-to-top]");
      if (toTop) {
        const paint = () => toTop.classList.toggle("show", window.scrollY > innerHeight * 1.2);
        addEventListener("scroll", paint, { passive: true });
        requestAnimationFrame(paint);
        toTop.addEventListener("click", (e) => {
          scrollTo({ top: 0, behavior: calm ? "auto" : "smooth" });
          // From the keyboard, continue from the top of the page too.
          if ((e as MouseEvent).detail === 0) document.querySelector<HTMLElement>(".skip")?.focus({ preventScroll: true });
        });
      }
    </script>
  </body>
</html>
