---
import { SHIPPING, formatEgp } from "@platform/commerce";
import { canonicalUrl, robotsDirective } from "@platform/seo";
import { deployEnvironment } from "../deploy-env.ts";
import Header from "../components/Header.astro";
import Consent from "../components/Consent.astro";
import Footer from "../components/Footer.astro";
import Cart from "../components/Cart.astro";
import { site as store } from "../site.ts";
import type { Lang } from "../site.ts";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  /** Site-relative path of the same page in the other language, e.g. "/en/". */
  altPath?: string;
  /** Optional JSON-LD, already serialized with serializeJsonLd. */
  jsonLd?: string;
  /** Pages that must never be indexed even in production (thank-you page). */
  noindex?: boolean;
  /** Social preview image, site-relative. Defaults to the brand photo. */
  image?: string;
  /** The poster of the film that opens the page. It is fetched first and at high priority: a poster is otherwise
      found late and fetched at low priority, and it is the largest thing on the first screen. */
  lcpImage?: string;
  /** "belts": the red belts look. "neutral": calm colours for pages that are not about the belts (home, contact, policies). */
  theme?: "belts" | "neutral";
}

const { title, description, lang = "ar", altPath, jsonLd, noindex = false, image = "/img/looks/wide-tie-mustard-1200.webp", theme = "belts", lcpImage } = Astro.props;

// Only the production build may be indexed (ADR 0005). DEPLOY_ENV is required at build time (see deploy-env.ts).
const env = deployEnvironment();
const site = Astro.site!.toString();
const canonical = canonicalUrl(site, Astro.url.pathname);
const alt = altPath ? canonicalUrl(site, altPath) : undefined;
const ogImage = new URL(image, site).toString();
const arUrl = lang === "ar" ? canonical : alt;
const enUrl = lang === "en" ? canonical : alt;
const PAUSE_SVG = '<svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M8 5.5v13M16 5.5v13" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>';
const switchHref = altPath ?? (lang === "ar" ? "/en/" : "/");
// Facts for the red announcement bar (all from the shared settings).
const ar = lang === "ar";
const announce = ar
  ? [`توصيل لكل مصر خلال ${store.deliveryDays} أيام عمل`, `شحن مجاني من ${formatEgp(SHIPPING.freeOver)} جنيه`, `استرجاع خلال ${store.returnDays} يومًا`, "الدفع عند الاستلام أو InstaPay"]
  : [`Delivery across Egypt in ${store.deliveryDays} working days`, `Free shipping from EGP ${formatEgp(SHIPPING.freeOver)}`, `${store.returnDays}-day returns`, "Cash on delivery or InstaPay"];
---

<!doctype html>
<html lang={lang} dir={lang === "ar" ? "rtl" : "ltr"} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex,nofollow" : robotsDirective(env)} />
    <link rel="canonical" href={canonical} />
    {arUrl && <link rel="alternate" hreflang="ar" href={arUrl} />}
    {enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    <link rel="alternate" hreflang="x-default" href={arUrl ?? canonical} />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Light or dark, as chosen in the menu on this device; applied before the page paints so it never flashes. */}
    <script is:inline>try{if(localStorage.getItem("vicuna-mode")==="dark"){document.documentElement.dataset.mode="dark";}}catch(e){}</script>
    <meta name="theme-color" content={theme === "neutral" ? "#f4f1ec" : "#ffffff"} />
    <meta property="og:locale" content={lang === "ar" ? "ar_EG" : "en_US"} />
    {lcpImage && <link rel="preload" href={lcpImage} as="image" type="image/webp" fetchpriority="high" />}
    <link rel="preload" href={lang === "ar" ? "/fonts/ibm-plex-sans-arabic-arabic-400-normal.woff2" : "/fonts/ibm-plex-sans-arabic-latin-400-normal.woff2"} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lang === "ar" ? "/fonts/el-messiri-arabic-700-normal.woff2" : "/fonts/el-messiri-latin-700-normal.woff2"} as="font" type="font/woff2" crossorigin />
    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
    {/* Browsers that support it fetch a page in the background as soon as a finger or the mouse rests on its link,
        so opening it feels instant. Prefetch only (no prerender): no page runs before it is really opened. */}
    <script type="speculationrules" set:html={JSON.stringify({ prefetch: [{ where: { and: [{ href_matches: "/*" }, { not: { href_matches: "/api/*" } }] }, eagerness: "moderate" }] })} />
  </head>
  <body>
    <a class="skip" href="#main">{lang === "ar" ? "تخطَّ إلى المحتوى" : "Skip to content"}</a>
    <Consent lang={lang} />
    <div class="announce" data-announce>
      <p class="sr-only">{announce.join(" · ")}</p>
      <button type="button" class="motion-toggle announce-toggle" data-announce-toggle data-label-pause={ar ? "إيقاف الشريط المتحرك" : "Pause the moving bar"} data-label-play={ar ? "تشغيل الشريط المتحرك" : "Play the moving bar"} aria-label={ar ? "إيقاف الشريط المتحرك" : "Pause the moving bar"}><span class="mt-dot" set:html={PAUSE_SVG} /></button>
      <div class="marquee" aria-hidden="true">
        <div class="marquee-track">
          {[0, 1].map(() => announce.map((a) => <span>{a}<i>✦</i></span>))}
        </div>
      </div>
    </div>
    <Header lang={lang} altHref={switchHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <Cart lang={lang} />
    <button type="button" class="to-top" data-to-top aria-label={ar ? "الرجوع لأعلى الصفحة" : "Back to top"}>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5.5 11.5 12 5l6.5 6.5" /></svg>
    </button>
    <script>
      // Header shadow once the page scrolls, and a gentle fade-up for sections as they come into view.
      const header = document.querySelector(".site-header");
      const onScroll = () => header?.toggleAttribute("data-scrolled", window.scrollY > 8);
      addEventListener("scroll", onScroll, { passive: true });
      onScroll();
      const items = document.querySelectorAll(".reveal");
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (!calm && "IntersectionObserver" in window) {
        document.documentElement.classList.add("reveal-ready");
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("in");
              io.unobserve(e.target);
            }
          },
          { rootMargin: "0px 0px -6% 0px" },
        );
        items.forEach((el) => io.observe(el));

        // Photos further down the page rise into view as they are reached (photos on the first screen show at
        // once). Photos that come into view together open one after another.
        const media = [...document.querySelectorAll<HTMLElement>(".card-media, .pdp-look, .sg-media, .lux-tile, .detail-media, .style-film, .sd-item")]
          .filter((el) => el.getBoundingClientRect().top > innerHeight);
        const rise = new IntersectionObserver(
          (entries) => {
            let n = 0;
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              const el = e.target as HTMLElement;
              el.style.setProperty("--rise-delay", `${Math.min(n++, 5) * 110}ms`);
              el.classList.add("in");
              rise.unobserve(el);
            }
          },
          { rootMargin: "0px 0px -8% 0px" },
        );
        for (const el of media) { el.classList.add("media-rise"); rise.observe(el); }
      }

      // Moving content (WCAG 2.2.2): videos marked data-motion and the announcement bar can be paused. The bar does not
      // move when the visitor's device asks for reduced motion; the films play (owner's choice) with a pause button.
      const lang = document.documentElement.lang === "en" ? "en" : "ar";
      // Small drawn icons (the ❚❚ and ▶ characters look different, and clumsy, on every phone).
      const PAUSE_ICON = '<span class="mt-dot"><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M8 5.5v13M16 5.5v13" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg></span>';
      const PLAY_ICON = '<span class="mt-dot"><svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M8 5.2v13.6a.6.6 0 0 0 .9.5l10.4-6.8a.6.6 0 0 0 0-1L8.9 4.7a.6.6 0 0 0-.9.5z" fill="currentColor"/></svg></span>';
      const words = lang === "ar" ? { pause: "إيقاف الفيديو", play: "تشغيل الفيديو" } : { pause: "Pause video", play: "Play video" };
      const blocked = new Set<HTMLVideoElement>();
      const retry = (e: Event) => {
        if ((e.target as Element | null)?.closest?.(".film-toggle")) return; // that button plays or pauses its own film
        blocked.forEach((v) => void v.play().then(() => blocked.delete(v), () => undefined));
      };
      for (const type of ["touchstart", "pointerdown", "keydown"]) addEventListener(type, retry, { passive: true });
      // Posters of films further down the page (data-poster) load only as the visitor nears them, so they do not
      // compete with the first screen.
      const later = document.querySelectorAll<HTMLVideoElement>("video[data-poster]");
      const showPoster = (v: HTMLVideoElement) => { v.poster = v.dataset["poster"] ?? ""; };
      if ("IntersectionObserver" in window) {
        const near = new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            showPoster(e.target as HTMLVideoElement);
            near.unobserve(e.target);
          }
        }, { rootMargin: "800px 0px" });
        later.forEach((v) => near.observe(v));
      } else later.forEach(showPoster);
      document.querySelectorAll<HTMLVideoElement>("video[data-motion]").forEach((video) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "motion-toggle film-toggle";
        const show = () => {
          const paused = video.paused;
          button.setAttribute("aria-label", paused ? words.play : words.pause);
          button.innerHTML = paused ? PLAY_ICON : PAUSE_ICON;
        };
        button.addEventListener("click", () => {
          if (video.paused) void video.play().catch(() => undefined);
          else video.pause();
        });
        video.addEventListener("play", show);
        video.addEventListener("pause", show);
        video.after(button);
        show();
        // The films always play by themselves (owner, 2026-10-16), also when the device asks for reduced motion;
        // each one keeps its pause button. When the phone blocks autoplay (iPhone Low Power Mode), the first touch
        // anywhere on the page starts the films on screen.
        // Films play only while they are on screen: a film further down the page is not downloaded until it is
        // reached, and one scrolled past stops (the visitor's own pause is kept).
        if (!("IntersectionObserver" in window)) { void video.play().catch(() => undefined); return; }
        let userPaused = false;
        button.addEventListener("click", () => { userPaused = video.paused; blocked.delete(video); });
        new IntersectionObserver((entries) => {
          for (const e of entries) {
            if (e.isIntersecting && !userPaused) { blocked.add(video); void video.play().then(() => blocked.delete(video), () => undefined); }
            else if (!e.isIntersecting) { blocked.delete(video); if (!video.paused) video.pause(); }
          }
        }, { threshold: 0.2 }).observe(video);
      });
      // Back to top: a round button that appears once the visitor has scrolled down more than a screen.
      const toTop = document.querySelector<HTMLButtonElement>("[data-to-top]");
      if (toTop) {
        const paint = () => toTop.classList.toggle("show", window.scrollY > innerHeight * 1.2);
        addEventListener("scroll", paint, { passive: true });
        paint();
        toTop.addEventListener("click", (e) => {
          scrollTo({ top: 0, behavior: calm ? "auto" : "smooth" });
          // From the keyboard, continue from the top of the page too.
          if ((e as MouseEvent).detail === 0) document.querySelector<HTMLElement>(".skip")?.focus({ preventScroll: true });
        });
      }

      const bar = document.querySelector<HTMLElement>("[data-announce]");
      const barButton = document.querySelector<HTMLButtonElement>("[data-announce-toggle]");
      if (bar && barButton) {
        if (calm) barButton.hidden = true;
        barButton.addEventListener("click", () => {
          const paused = bar.classList.toggle("paused");
          barButton.setAttribute("aria-label", (paused ? barButton.dataset["labelPlay"] : barButton.dataset["labelPause"]) ?? "");
          barButton.innerHTML = paused ? PLAY_ICON : PAUSE_ICON;
        });
      }
    </script>
  </body>
</html>
