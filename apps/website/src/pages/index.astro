---
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import { organizationJsonLd, serializeJsonLd, websiteJsonLd } from "@platform/seo";
import { site } from "../site.ts";

const title = "فيكونا | أحزمة خصر نسائية مصنوعة في مصر";
const description = "فيكونا علامة مصرية لأحزمة الخصر النسائية: تصاميم من جلد PU والدانتيل، وأحزمة جلد طبيعي تُفصّل على المقاس. توصيل لجميع المحافظات.";
const jsonLd = serializeJsonLd([
  organizationJsonLd({
    name: site.nameAr,
    url: site.url,
    logo: `${site.url}/brand/vicuna-lockup.svg`,
    email: site.email,
    sameAs: site.social.map((s) => s.href),
  }),
  websiteJsonLd({ name: site.nameAr, url: site.url, language: "ar" }),
]);
---

<Base title={title} description={description} lang="ar" altPath="/en/" jsonLd={jsonLd}>
  <Home lang="ar" />
</Base>
