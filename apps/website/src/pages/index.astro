---
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import { organizationJsonLd, serializeJsonLd, websiteJsonLd } from "@platform/seo";
import { site } from "../site.ts";
import { COLLAGE_SRCSET } from "../lib/looks.ts";

const title = "Vicuna | The waist belt that makes every outfit";
const description = "Vicuna is a distinctive brand in leather making, website building and social media services. Waist belts that make every outfit, delivered across Egypt.";
const jsonLd = serializeJsonLd([
  organizationJsonLd({
    name: site.nameEn,
    legalName: site.legalNameEn,
    url: site.url,
    logo: `${site.url}/brand/vicuna-logo.png`,
    email: site.email,
    telephone: `+${site.whatsappInternational}`,
    address: site.addressParts,
  }),
  websiteJsonLd({ name: site.nameEn, url: site.url, language: "en" }),
]);
---

<Base title={title} description={description} lang="en" jsonLd={jsonLd} image="/img/looks/lace-white-1200.webp" lcpImage="/img/founder-collage-1400.webp" lcpSrcset={COLLAGE_SRCSET} howto>
  <Home lang="en" />
</Base>
