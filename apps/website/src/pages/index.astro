---
import Base from "../layouts/Base.astro";
import Home from "../components/Home.astro";
import { organizationJsonLd, serializeJsonLd, websiteJsonLd } from "@platform/seo";
import { site } from "../site.ts";

const title = "فيكونا | حزام الوسط اللي يفرق في كل لبسة";
const description = "فيكونا علامة تجارية مميزة في تصنيع الجلود، وخدمات بناء المواقع والسوشيال ميديا. أحزمة وسط وخصر تفرق في كل لبسة، وتوصيل لكل مصر.";
const jsonLd = serializeJsonLd([
  // No sameAs: the social links in site.ts are not confirmed as the brand's own accounts (owner to confirm).
  organizationJsonLd({
    name: site.nameAr,
    legalName: site.legalNameEn,
    url: site.url,
    logo: `${site.url}/brand/vicuna-logo.png`,
    email: site.email,
    telephone: `+${site.whatsappInternational}`,
    address: site.addressParts,
  }),
  websiteJsonLd({ name: site.nameAr, url: site.url, language: "ar" }),
]);
---

<Base title={title} description={description} lang="ar" altPath="/en/" jsonLd={jsonLd} theme="neutral" image="/img/editorial/lace-close-1600.webp">
  <Home lang="ar" />
</Base>
