---
// One style guide, in Arabic or English. Its page links to the belts it shows, to the same guide in the other
// language (with hreflang alternates), and to more guides in its language.
import { articleJsonLd, breadcrumbJsonLd, serializeJsonLd } from "@platform/seo";
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ProductCard from "../../../components/ProductCard.astro";
import { articleUrl, articlesIn, coverSrcset, formatDate, getArticle, translationOf, articles } from "../../../lib/articles.ts";
import { beltsUrl, getProduct } from "../../../store.ts";
import { JOURNAL_PATH, site } from "../../../site.ts";

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug } }));
}

const article = getArticle(Astro.params.slug!)!;
const { Content } = article;
const lang = article.lang;
const ar = lang === "ar";
const t = ar
  ? { home: "الرئيسية", belts: "أحزمة الخصر", journal: "المقالات", products: "أحزمة الخصر في المقال", more: "اقرئي أيضًا", other: "Read this guide in English", all: "كل المقالات", shop: "تسوّقي أحزمة الخصر", brand: site.nameAr }
  : { home: "Home", belts: "Waist belts", journal: "Journal", products: "Belts in this guide", more: "Read next", other: "اقرئي المقال بالعربي", all: "All guides", shop: "Shop all waist belts", brand: "Vicuna" };
const related = article.products.map((id) => getProduct(id)).filter((p) => p !== undefined).slice(0, 4);
const more = articlesIn(lang).filter((a) => a.slug !== article.slug).slice(0, 3);
const other = translationOf(article);
const alternates = other ? [{ lang, href: articleUrl(article.slug) }, { lang: other.lang, href: articleUrl(other.slug) }] : [];
const url = `${site.url}${articleUrl(article.slug)}`;
// The belts pages are English (ADR 0015), so their crumb keeps its English address in both languages.
const crumbs = [{ name: t.home, href: "/" }, { name: t.belts, href: beltsUrl("en") }, { name: t.journal, href: JOURNAL_PATH }, { name: article.title }];
const jsonLd = serializeJsonLd([
  articleJsonLd({
    headline: article.title,
    description: article.description,
    url,
    images: [`${site.url}${article.image}`],
    datePublished: article.datePublished,
    ...(article.dateModified ? { dateModified: article.dateModified } : {}),
    authorName: t.brand,
    authorType: "Organization",
    publisherName: t.brand,
    publisherLogo: `${site.url}/brand/vicuna-logo.png`,
  }),
  breadcrumbJsonLd([
    { name: t.home, url: `${site.url}/` },
    { name: t.belts, url: `${site.url}${beltsUrl("en")}` },
    { name: t.journal, url: `${site.url}${JOURNAL_PATH}` },
    { name: article.title, url },
  ]),
]);
const titleTag = `${article.title} | ${ar ? "فيكونا" : "Vicuna"}`;
---

<Base title={titleTag.length <= 70 ? titleTag : article.title} description={article.description} lang={lang} jsonLd={jsonLd} image={article.image} alternates={alternates} lcpImage={article.image} lcpSrcset={coverSrcset(article.image) || undefined}>
  <Breadcrumbs items={crumbs} />
  <article class="wrap article">
    <header>
      <h1>{article.title}</h1>
      <p class="article-meta muted">
        <time datetime={article.datePublished}>{formatDate(article.datePublished, lang)}</time>
        {other && <> · <a class="textlink" href={articleUrl(other.slug)} hreflang={other.lang} lang={other.lang}>{t.other}</a></>}
      </p>
    </header>
    <img class="cover" src={article.image} srcset={coverSrcset(article.image) || undefined} sizes="(min-width: 820px) 780px, calc(100vw - 40px)" alt={article.imageAlt} width={article.imageWidth} height={article.imageHeight} fetchpriority="high" />
    <div class="prose"><Content /></div>
  </article>
  {related.length > 0 && (
    <section class="wrap style-group">
      <div class="group-head"><h2>{t.products}</h2></div>
      <div class="grid">{related.map((p) => <ProductCard product={p} lang={lang} />)}</div>
    </section>
  )}
  <section class="wrap style-group">
    <div class="group-head"><h2>{t.more}</h2></div>
    <ul class="more-list">
      {more.map((a) => <li><a class="textlink" href={articleUrl(a.slug)}>{a.title}</a></li>)}
    </ul>
    <p class="article-links"><a class="text-btn" href={JOURNAL_PATH}>{t.all}</a> <a class="text-btn" href={beltsUrl("en")}>{t.shop}</a></p>
  </section>
</Base>
