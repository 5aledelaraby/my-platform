---
// The journal: style guides in English, then the same guides in Arabic (in their own right-to-left section). It is
// linked from the footer, the belts pages and the product pages, not from the main menu.
import { breadcrumbJsonLd, serializeJsonLd } from "@platform/seo";
import Base from "../../../layouts/Base.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import { articlesIn, articleUrl, formatDate } from "../../../lib/articles.ts";
import type { Article } from "../../../lib/articles.ts";
import { JOURNAL_PATH, site } from "../../../site.ts";
import { beltsUrl } from "../../../store.ts";

const title = "Journal | Waist belt style guides | Vicuna";
const description = "How to choose, tie and style a waist belt with dresses, abayas and jackets: practical guides from Vicuna, in English and Arabic.";
const crumbs = [{ name: "Home", href: "/" }, { name: "Waist belts", href: beltsUrl("en") }, { name: "Journal" }];
const jsonLd = serializeJsonLd(
  breadcrumbJsonLd([{ name: "Home", url: `${site.url}/` }, { name: "Waist belts", url: `${site.url}${beltsUrl("en")}` }, { name: "Journal", url: `${site.url}${JOURNAL_PATH}` }]),
);
const groups: { lang: "en" | "ar"; heading: string; list: Article[] }[] = [
  { lang: "en", heading: "Style guides", list: articlesIn("en") },
  { lang: "ar", heading: "مقالات بالعربي", list: articlesIn("ar") },
];
---

<Base title={title} description={description} lang="en" jsonLd={jsonLd}>
  <Breadcrumbs items={crumbs} />
  <div class="wrap page-head">
    <h1>Journal</h1>
    <p class="muted lede">How to choose, tie and style a waist belt, in English and Arabic.</p>
  </div>
  {groups.filter((g) => g.list.length > 0).map((g) => (
    <section class="wrap journal-group" lang={g.lang} dir={g.lang === "ar" ? "rtl" : "ltr"}>
      <h2 class="section-title">{g.heading}</h2>
      <div class="posts">
        {g.list.map((a) => (
          <a class="post" href={articleUrl(a.slug)}>
            <img src={a.image} alt={a.imageAlt} width={a.imageWidth} height={a.imageHeight} loading="lazy" decoding="async" />
            <time datetime={a.datePublished} class="muted">{formatDate(a.datePublished, a.lang)}</time>
            <h3>{a.title}</h3>
            <p class="muted">{a.description}</p>
          </a>
        ))}
      </div>
    </section>
  ))}
  <p class="wrap looks-more"><a class="text-btn" href={beltsUrl("en")}>Shop all waist belts</a></p>
</Base>
