---
import Base from "../../layouts/Base.astro";
import Home from "../../components/Home.astro";
import { serializeJsonLd, websiteJsonLd } from "@platform/seo";
import { site } from "../../site.ts";

const title = "Vicuna | Women's waist belts made in Egypt";
const description = "Vicuna is an Egyptian brand of women's waist belts: designs in PU leather and lace, and natural leather belts made to measure. Delivery to every governorate.";
const jsonLd = serializeJsonLd(websiteJsonLd({ name: site.nameEn, url: `${site.url}/en/`, language: "en" }));
---

<Base title={title} description={description} lang="en" altPath="/" jsonLd={jsonLd}>
  <Home lang="en" />
</Base>
