---
import Base from "../../layouts/Base.astro";
import Home from "../../components/Home.astro";
import { serializeJsonLd, websiteJsonLd } from "@platform/seo";
import { site } from "../../site.ts";

const title = "Vicuna | Simple designs, made with care";
const description = "Vicuna is an Egyptian trading and design brand: we design and make by hand. Meet us and our sections, including belts and made-to-measure pieces.";
const jsonLd = serializeJsonLd(websiteJsonLd({ name: site.nameEn, url: `${site.url}/en/`, language: "en" }));
---

<Base title={title} description={description} lang="en" altPath="/" jsonLd={jsonLd} theme="neutral" image="/img/ai/still-life.webp">
  <Home lang="en" />
</Base>
