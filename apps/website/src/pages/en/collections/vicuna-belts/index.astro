---
import { breadcrumbJsonLd, serializeJsonLd } from "@platform/seo";
import Base from "../../../../layouts/Base.astro";
import BeltsHome from "../../../../components/BeltsHome.astro";
import { homeCopy } from "../../../../home-copy.ts";
import { site } from "../../../../site.ts";
import { beltsUrl, styles } from "../../../../store.ts";
import { leadPoster } from "../../../../lib/designs.ts";

const c = homeCopy.en;
const jsonLd = serializeJsonLd(
  breadcrumbJsonLd([
    { name: "Home", url: `${site.url}/en/` },
    { name: "Belts", url: `${site.url}${beltsUrl("en")}` },
  ]),
);
---

<Base title={c.title} description={c.description} lang="en" altPath={beltsUrl("ar")} jsonLd={jsonLd} lcpImage={leadPoster(styles[0]!.id)}>
  <BeltsHome lang="en" />
</Base>
