---
import { articleJsonLd, breadcrumbJsonLd, serializeJsonLd } from "@platform/seo";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ProductCard from "../../components/ProductCard.astro";
import { articles, articleUrl, formatDate, getArticle } from "../../lib/articles.ts";
import { getProduct } from "../../store.ts";
import { site } from "../../site.ts";

export function getStaticPaths() {
  return articles.map((a) => ({ params: { slug: a.slug } }));
}

const article = getArticle(Astro.params.slug!)!;
const { Content } = article;
const related = article.products.map((id) => getProduct(id)).filter((p) => p !== undefined).slice(0, 4);
const more = articles.filter((a) => a.slug !== article.slug).slice(0, 3);
const url = `${site.url}${articleUrl(article.slug)}`;
const crumbs = [{ name: "الرئيسية", href: "/" }, { name: "المقالات", href: "/blog/" }, { name: article.title }];
const jsonLd = serializeJsonLd([
  articleJsonLd({
    headline: article.title,
    description: article.description,
    url,
    images: [`${site.url}${article.image}`],
    datePublished: article.datePublished,
    ...(article.dateModified ? { dateModified: article.dateModified } : {}),
    authorName: site.nameAr,
    authorType: "Organization",
    publisherName: site.nameAr,
    publisherLogo: `${site.url}/brand/vicuna-lockup.svg`,
  }),
  breadcrumbJsonLd([
    { name: "الرئيسية", url: `${site.url}/` },
    { name: "المقالات", url: `${site.url}/blog/` },
    { name: article.title, url },
  ]),
]);
---

<Base title={`${article.title} | فيكونا`} description={article.description} lang="ar" jsonLd={jsonLd} image={article.image}>
  <Breadcrumbs items={crumbs} />
  <article class="wrap article">
    <header>
      <h1>{article.title}</h1>
      <time datetime={article.datePublished} class="muted">{formatDate(article.datePublished)}</time>
    </header>
    <img class="cover" src={article.image} alt={article.imageAlt} width={article.imageWidth} height={article.imageHeight} fetchpriority="high" />
    <div class="prose"><Content /></div>
  </article>
  {related.length > 0 && (
    <section class="wrap style-group">
      <div class="group-head"><h2>أحزمة من المقال</h2></div>
      <div class="grid">{related.map((p) => <ProductCard product={p} lang="ar" />)}</div>
    </section>
  )}
  <section class="wrap style-group">
    <div class="group-head"><h2>اقرئي أيضًا</h2></div>
    <ul class="more-list">
      {more.map((a) => <li><a class="textlink" href={articleUrl(a.slug)}>{a.title}</a></li>)}
    </ul>
  </section>
</Base>
