---
import ProductPage from "../../../components/ProductPage.astro";
import StylePage from "../../../components/StylePage.astro";
import PatternPage from "../../../components/PatternPage.astro";
import { getProduct, products, styles } from "../../../store.ts";

export function getStaticPaths() {
  return [...styles.map((s) => ({ params: { slug: s.id } })), ...products.map((p) => ({ params: { slug: p.id } }))];
}

const { slug } = Astro.params;
const product = getProduct(slug!);
---

{product ? <ProductPage lang="ar" product={product} /> : slug === "pattern" ? <PatternPage lang="ar" styleId={slug!} /> : <StylePage lang="ar" styleId={slug!} />}
