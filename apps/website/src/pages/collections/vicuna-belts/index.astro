---
// The belts collection: one full page with the belts story and every belt (ADR 0009).
import { breadcrumbJsonLd, serializeJsonLd } from "@platform/seo";
import Base from "../../../layouts/Base.astro";
import BeltsHome from "../../../components/BeltsHome.astro";
import { homeCopy } from "../../../home-copy.ts";
import { site } from "../../../site.ts";
import { beltsUrl } from "../../../store.ts";

const c = homeCopy.ar;
const jsonLd = serializeJsonLd(
  breadcrumbJsonLd([
    { name: "الرئيسية", url: `${site.url}/` },
    { name: "الأحزمة", url: `${site.url}${beltsUrl("ar")}` },
  ]),
);
---

<Base title={c.title} description={c.description} lang="ar" altPath={beltsUrl("en")} jsonLd={jsonLd}>
  <BeltsHome lang="ar" />
</Base>
