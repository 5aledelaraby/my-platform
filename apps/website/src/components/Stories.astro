---
// Round style shortcuts ("story circles"): All + one circle per design.
import { beltsUrl, coverOf, styleText, styles, thumbOf } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang; current?: string }
const { lang, current } = Astro.props;
const ar = lang === "ar";
---

<nav class="stories" aria-label={ar ? "التصميمات" : "Designs"}>
  <div class="stories-row">
    <a class="story" href={`${beltsUrl(lang)}#all`} aria-current={current === "all" ? "page" : undefined}>
      <span class="story-ring"><span><svg viewBox="0 0 24 24" width="30" height="30" aria-hidden="true"><path fill="var(--berry)" d="M12 21s-7.5-4.6-9.6-9.2C1 8.6 3 5 6.6 5c2.1 0 3.6 1.2 5.4 3.1C13.8 6.2 15.3 5 17.4 5 21 5 23 8.6 21.6 11.8 19.5 16.4 12 21 12 21Z" /></svg></span></span>
      {ar ? "الكل" : "All"}
    </a>
    {styles.map((s) => (
      <a class="story" href={beltsUrl(lang, s.id)} aria-current={current === s.id ? "page" : undefined}>
        <span class="story-ring"><span><img src={thumbOf(coverOf(s.id))} alt="" width="84" height="84" loading="lazy" decoding="async" /></span></span>
        {styleText(lang, s.id).name}
      </a>
    ))}
  </div>
</nav>
