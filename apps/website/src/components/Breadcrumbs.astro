---
interface Props { items: readonly { name: string; href?: string }[]; lang?: "ar" | "en" }
const { items, lang = "en" } = Astro.props;
---

<nav class="crumbs" aria-label={lang === "ar" ? "مسار الصفحة" : "breadcrumb"}>
  <div class="wrap">
    {items.map((it, i) => (
      <>
        {i > 0 && <span aria-hidden="true"> › </span>}
        {it.href ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}
      </>
    ))}
  </div>
</nav>
