---
// Header (owner, 2026-10-19): white, with the menu button, the logo in the middle and the favourites and bag on the
// other side, like the big fashion stores. The menu is a white panel from the side with plain links. On the home page
// (`overlay`, owner 2026-10-20) it sits on the photo with no white bar, in white, and turns white with dark icons once
// the visitor scrolls.
import { POLICY_IDS, getPolicy, policyPath } from "../policies/index.ts";
import { beltsUrl, styleText, styles } from "../store.ts";
import Logo from "./ui/Logo.astro";
import { langPath } from "../site.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang; overlay?: boolean; switchHref: string }
const { lang, overlay = false, switchHref } = Astro.props;
const ar = lang === "ar";
const home = langPath(lang, "/");
const here = (href: string) => Astro.url.pathname === href;
const designs = styles.map((st) => ({ href: beltsUrl(lang, st.id), label: styleText(lang, st.id).name }));
const help = [
  { href: langPath(lang, "/about/"), label: ar ? "من نحن" : "About us" },
  { href: langPath(lang, "/contact/"), label: ar ? "تواصلي معنا" : "Contact" },
  { href: langPath(lang, "/faq/"), label: ar ? "الأسئلة الشائعة" : "FAQ" },
  { href: langPath(lang, "/favorites/"), label: ar ? "المفضلة" : "Wishlist" },
];
const line = (d: string, size = 24) => `<svg viewBox="0 0 24 24" width="${size}" height="${size}" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">${d}</svg>`;
---

<header class={overlay ? "site-header is-overlay" : "site-header"}>
  <div class="wrap header-bar">
    <button type="button" class="icon-btn menu-btn" data-open-menu aria-controls="menu" aria-expanded="false" aria-label={ar ? "القائمة" : "Menu"}>
      <Fragment set:html={line('<path d="M3.5 6.5h17M3.5 12h17M3.5 17.5h17"/>', 26)} />
    </button>
    <a class="brand" href={home}><Logo size={30} both={overlay} /></a>
    <div class="header-end">
      <a class="icon-btn fav-link" href={langPath(lang, "/favorites/")} aria-label={ar ? "المفضلة" : "Wishlist"}>
        <Fragment set:html={line('<path d="M12 20.3s-7.3-4.4-9.2-8.9C1.5 8.3 3.4 4.8 6.9 4.8c2 0 3.5 1.1 5.1 2.9 1.6-1.8 3.1-2.9 5.1-2.9 3.5 0 5.4 3.5 4.1 6.6-1.9 4.5-9.2 8.9-9.2 8.9z"/>', 22)} />
        <span class="count-badge fav-count" data-fav-count hidden>0</span>
      </a>
      <button type="button" class="icon-btn bag-btn" data-open-cart aria-label={ar ? "السلة" : "Cart"}>
        <Fragment set:html={line('<path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/>')} />
        <span class="count-badge" data-cart-count hidden>0</span>
      </button>
    </div>
  </div>
</header>

<dialog id="menu" class="menu" aria-label={ar ? "القائمة" : "Menu"}>
  <div class="menu-inner" tabindex="-1" autofocus>
    <div class="menu-head">
      <button type="button" class="menu-close" data-close-menu aria-label={ar ? "إغلاق القائمة" : "Close the menu"}>
        <Fragment set:html={line('<path d="M6 6l12 12M18 6 6 18"/>', 24)} />
      </button>
    </div>
    <nav class="menu-nav" aria-label={ar ? "القائمة" : "Menu"}>
      <ul class="menu-main">
        <li><a href={beltsUrl(lang)} aria-current={here(beltsUrl(lang)) ? "page" : undefined}>{ar ? "كل أحزمة الخصر" : "Shop all"}</a></li>
        {designs.map((d) => <li><a href={d.href} aria-current={here(d.href) ? "page" : undefined}>{d.label}</a></li>)}
      </ul>
      <ul class="menu-small">
        {help.map((h) => <li><a href={h.href} aria-current={here(h.href) ? "page" : undefined}>{h.label}</a></li>)}
        {POLICY_IDS.map((id) => <li><a href={policyPath(lang, id)}>{getPolicy(id).title}</a></li>)}
        <li>{ar ? <a class="menu-lang" href={switchHref} hreflang="en" lang="en">English</a> : <a class="menu-lang" href={switchHref} hreflang="ar" lang="ar">العربية</a>}</li>
      </ul>
    </nav>
  </div>
</dialog>

<script>
  import "../scripts/favorites.ts";
  // The home header: on the photo at the top, a white bar after a little scrolling. Reads only scrollY (no layout).
  const overlay = document.querySelector<HTMLElement>(".site-header.is-overlay");
  if (overlay) {
    const paint = () => overlay.toggleAttribute("data-scrolled", window.scrollY > 24);
    addEventListener("scroll", paint, { passive: true });
    paint();
  }
  const menu = document.getElementById("menu") as HTMLDialogElement | null;
  const openBtn = document.querySelector<HTMLButtonElement>("[data-open-menu]");
  openBtn?.addEventListener("click", () => {
    if (!menu || menu.open) return;
    menu.showModal();
    openBtn.setAttribute("aria-expanded", "true");
  });
  menu?.addEventListener("close", () => openBtn?.setAttribute("aria-expanded", "false"));
  // Close on the ✕ button or a tap on the dimmed area outside the panel (the panel itself is .menu-inner).
  menu?.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (target === menu || target.closest("[data-close-menu]")) menu.close();
  });
</script>
