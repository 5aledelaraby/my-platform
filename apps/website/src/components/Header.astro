---
import { langPath } from "../site.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang; altHref: string }
const { lang, altHref } = Astro.props;
const ar = lang === "ar";
---

<header class="site-header">
  <div class="wrap">
    <a class="logo" href={langPath(lang, "/")} aria-label={ar ? "فيكونا - الرئيسية" : "Vicuna - Home"}>
      <img src="/brand/vicuna-lockup.svg" alt="Vicuna" width="125" height="40" />
    </a>
    <nav class="nav" aria-label={ar ? "التنقل الرئيسي" : "Main navigation"}>
      <a href={langPath(lang, "/belts/")}>{ar ? "الأحزمة" : "Belts"}</a>
      <button type="button" class="cart-btn" data-open-cart>{ar ? "السلة" : "Cart"} <span data-cart-count hidden>0</span></button>
      <a class="lang" href={altHref} hreflang={ar ? "en" : "ar"} lang={ar ? "en" : "ar"}>{ar ? "English" : "العربية"}</a>
    </nav>
  </div>
</header>
