---
import { MULTI_ITEM_RATES_BPS, SHIPPING, formatEgp } from "@platform/commerce";
import { breadcrumbJsonLd, serializeJsonLd } from "@platform/seo";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import ProductCard from "./ProductCard.astro";
import { beltsUrl, colorName, colors, price, products, productsOfStyle, styleText, styles } from "../store.ts";
import { langPath, site } from "../site.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
const cur = ar ? "جنيه" : "EGP";
const second = MULTI_ITEM_RATES_BPS[1] / 100;
const third = MULTI_ITEM_RATES_BPS[2] / 100;
const free = formatEgp(SHIPPING.freeOver);
const lowest = formatEgp(Math.min(...styles.map((s) => s.price)));
const title = ar ? "أحزمة خصر نسائية من جلد PU | فيكونا" : "Women's waist belts in PU leather | Vicuna";
const description = ar
  ? `${products.length} حزام خصر نسائي من فيكونا في ${styles.length} تصاميم: دانتيل وفيونكة وكروكو وثعبان وكشكشة، بأسعار من ${lowest} جنيه. توصيل لجميع المحافظات.`
  : `${products.length} women's waist belts from Vicuna in ${styles.length} designs: lace, bow, croc, snake and ruffle, from ${lowest} EGP. Delivery to every governorate.`;
const crumbs = [
  { name: ar ? "الرئيسية" : "Home", href: langPath(lang, "/") },
  { name: ar ? "الأحزمة" : "Belts" },
];
const jsonLd = serializeJsonLd(
  breadcrumbJsonLd([
    { name: crumbs[0]!.name, url: `${site.url}${crumbs[0]!.href}` },
    { name: crumbs[1]!.name, url: `${site.url}${beltsUrl(lang)}` },
  ]),
);
---

<Base title={title} description={description} lang={lang} altPath={beltsUrl(ar ? "en" : "ar")} jsonLd={jsonLd}>
  <Breadcrumbs items={crumbs} />
  <div class="wrap page-head">
    <h1>{ar ? "أحزمة خصر نسائية" : "Women's waist belts"}</h1>
    <p class="muted lede">
      {ar
        ? `جلد PU بقصّ ليزر وخياطة يدوية، في ${styles.length} تصاميم وعدة ألوان. اختاري التصميم ثم اللون، ونوصّل إلى جميع محافظات مصر خلال ${site.deliveryDays} أيام.`
        : `PU leather, laser-cut and hand-sewn, in ${styles.length} designs and many colours. Choose a design, then a colour; we deliver to every governorate in Egypt in ${site.deliveryDays} days.`}
    </p>
    <ul class="facts">
      <li>{ar ? "المقاس المعتاد: عرض 14 سم وطول 140 سم" : "Usual size: 14 cm wide, 140 cm long"}</li>
      <li>{ar ? `يناسب حتى ${site.maxWeightKg} كجم` : `Fits up to ${site.maxWeightKg} kg`}</li>
      <li>{ar ? `خصم ${second}% على الحزام الثاني و${third}% على الثالث` : `${second}% off the 2nd belt, ${third}% off the 3rd`}</li>
      <li>{ar ? `شحن مجاني فوق ${free} جنيه` : `Free shipping over ${free} EGP`}</li>
    </ul>
  </div>

  <div class="wrap shop-tools">
    <nav class="chips" aria-label={ar ? "تسوقي حسب التصميم" : "Shop by design"}>
      {styles.map((s) => <a href={beltsUrl(lang, s.id)}>{styleText(lang, s.id).name}</a>)}
    </nav>
    <div class="filter" data-filter data-unit={ar ? "حزام" : "belts"} hidden>
      <span class="filter-label">{ar ? "اللون:" : "Colour:"}</span>
      <div class="swatch-row">
        {colors.map((c) => (
          <button type="button" class="swatch" data-color={c.id} aria-pressed="false" title={colorName(lang, c.id)} aria-label={colorName(lang, c.id)} style={`--c:${c.hex}`}></button>
        ))}
      </div>
      <button type="button" class="link" data-color="all">{ar ? "عرض الكل" : "Show all"}</button>
      <span id="filter-status" class="muted" aria-live="polite"></span>
    </div>
  </div>

  {styles.map((s) => {
    const t = styleText(lang, s.id);
    return (
      <section class="wrap style-group" data-group aria-labelledby={`g-${s.id}`}>
        <div class="group-head">
          <h2 id={`g-${s.id}`}>{t.name}</h2>
          <span class="muted">{price(s.id)} {cur}</span>
          <a class="textlink" href={beltsUrl(lang, s.id)}>{ar ? `تفاصيل مجموعة ${t.name}` : `About the ${t.name} collection`} →</a>
        </div>
        <p class="muted group-intro">{t.headline}</p>
        <div class="grid">
          {productsOfStyle(s.id).map((p) => <ProductCard product={p} lang={lang} />)}
        </div>
      </section>
    );
  })}

  <section class="wrap style-group guide">
    <h2>{ar ? "كيف تختارين حزام الخصر؟" : "How to choose a waist belt"}</h2>
    <p class="muted">
      {ar
        ? "الحزام العريض بشريط للربط يحدّد الخصر فوق الفستان أو البلوزة الطويلة، والتصميمات ذات الفيونكة تجعله محور الإطلالة. للأزياء السادة تناسبك النقشات مثل الكروكو والثعبان، وللمناسبات يناسب الدانتيل. وإن تردّدتِ بين لونين فاللون المحايد (الأسود أو البني أو الأبيض) يتماشى مع معظم خزانتك."
        : "A wide belt with a tie defines the waist over a dress or a long blouse, and bow designs make it the focus of the outfit. Textures such as croc and snake suit plain outfits, and lace suits occasions. If you hesitate between two colours, a neutral (black, brown or white) goes with most of your wardrobe."}
    </p>
    <p class="muted">
      {ar
        ? "تحتاجين مقاسًا مختلفًا أو جلدًا طبيعيًا؟ نقبل الطلبات الخاصة، وتجدين طريقة التواصل في أسفل الصفحة."
        : "Need a different size or natural leather? We take custom orders; you will find how to reach us in the footer."}
    </p>
  </section>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>("[data-filter]");
  if (bar) {
    bar.hidden = false;
    const cards = [...document.querySelectorAll<HTMLElement>(".card[data-color]")];
    const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
    const status = document.getElementById("filter-status");
    const unit = bar.dataset["unit"] ?? "";
    let active: string | null = null;
    bar.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-color]");
      if (!button) return;
      const picked = button.dataset["color"] ?? "all";
      active = picked === "all" || picked === active ? null : picked;
      bar.querySelectorAll<HTMLButtonElement>(".swatch").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset["color"] === active)));
      let shown = 0;
      for (const card of cards) {
        const show = active === null || card.dataset["color"] === active;
        card.hidden = !show;
        if (show) shown += 1;
      }
      for (const group of groups) group.hidden = [...group.querySelectorAll<HTMLElement>(".card")].every((c) => c.hidden);
      if (status) status.textContent = active === null ? "" : `${shown} ${unit}`;
    });
  }
</script>
