---
// A design page (owner, 2026-10-19): the collection layout filtered to one design (Collection.astro). Title,
// description and breadcrumb data stay as they were for search.
import { breadcrumbJsonLd, serializeJsonLd } from "@platform/seo";
import Base from "../layouts/Base.astro";
import Collection from "./Collection.astro";
import { beltsUrl, coverOf, hasHigherPrices, imageOf, price, productsOfStyle, styleText } from "../store.ts";
import { colourCount } from "../lib/designs.ts";
import { langPath, site } from "../site.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang; styleId: string }
const { lang, styleId } = Astro.props;
const ar = lang === "ar";
const t = styleText(lang, styleId);
const list = productsOfStyle(styleId);
const from = hasHigherPrices(styleId);
const title = ar ? `حزام خصر ${t.name} | فيكونا` : `${t.name} waist belt | Vicuna`;
const description = ar
  ? `${t.headline}. ${colourCount(lang, list.length)} بسعر ${from ? "يبدأ من " : ""}${price(styleId)} جنيه. توصيل لكل مصر خلال ${site.deliveryDays} أيام.`
  : `${t.headline}. ${colourCount(lang, list.length)} ${from ? "from" : "at"} ${price(styleId)} EGP. Delivery across Egypt in ${site.deliveryDays} days.`;
const jsonLd = serializeJsonLd(
  breadcrumbJsonLd([
    { name: ar ? "الرئيسية" : "Home", url: `${site.url}${langPath(lang, "/")}` },
    { name: ar ? "أحزمة الخصر" : "Waist belts", url: `${site.url}${beltsUrl(lang)}` },
    { name: t.name, url: `${site.url}${beltsUrl(lang, styleId)}` },
  ]),
);
---

<Base title={title} description={description} lang={lang} jsonLd={jsonLd} image={imageOf(coverOf(styleId))} howto>
  <Collection lang={lang} styleId={styleId} />
</Base>
