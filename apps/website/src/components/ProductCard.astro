---
import type { CatalogProduct } from "@platform/commerce";
import { beltsUrl, priceOfProduct, productName, srcsetOf, thumbOf } from "../store.ts";
import type { Lang } from "../site.ts";
import { lookOf } from "../lib/looks.ts";

interface Props { product: CatalogProduct; lang: Lang; index?: number }
const { product, lang, index = 0 } = Astro.props;
const ar = lang === "ar";
const name = productName(lang, product);
const href = beltsUrl(lang, product.id);
// The on-model photo fades in over the product photo on hover (mouse only), and loads only when it is first needed.
const look = lookOf(product);
---

<article class="card reveal" data-color={product.color} data-product={product.id} data-style={product.style} style={`--i:${index % 2}`}>
  <div class={look ? "card-media glow has-look" : "card-media glow"} style={`--tint:${product.hex}`}>
    <a href={href} aria-label={name}>
      <img src={thumbOf(product)} srcset={srcsetOf(product)} sizes="(min-width: 1100px) 23vw, (min-width: 760px) 31vw, 48vw" alt={name} width="480" height="480" loading="lazy" decoding="async" />
      {look && <img class="card-look" src={look.src} alt="" width="640" height="800" loading="lazy" decoding="async" />}
    </a>
    <button type="button" class="quick-add bag-cta" data-add={product.id} aria-label={ar ? `أضيفي ${name} للسلة` : `Add ${name} to cart`}><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></button>
    <button type="button" class="fav-btn" data-fav={product.id} data-fav-name={name} aria-pressed="false" aria-label={ar ? `إضافة ${name} للمفضلة` : `Add ${name} to favourites`}><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 20.3s-7.3-4.4-9.2-8.9C1.5 8.3 3.4 4.8 6.9 4.8c2 0 3.5 1.1 5.1 2.9 1.6-1.8 3.1-2.9 5.1-2.9 3.5 0 5.4 3.5 4.1 6.6-1.9 4.5-9.2 8.9-9.2 8.9z" /></svg></button>
    <span class="card-out" data-soldout-for={product.id} hidden>{ar ? "نفدت الكمية" : "Sold out"}</span>
  </div>
  <div class="card-body">
    <h3 class="card-name"><a href={href}>{name}</a></h3>
    <span class="card-price">{ar ? `${priceOfProduct(product)} جنيه` : `LE ${priceOfProduct(product)}`}</span>
  </div>
</article>
