---
import Logo from "./ui/Logo.astro";
import { POLICY_IDS, getPolicy, policyPath } from "../policies/index.ts";
import { langPath, site } from "../site.ts";
import { beltsUrl, styleText, styles } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
// Footer (owner, 2026-10-19/20): his dark photo of a black bow belt behind it, with the words in white over it; the
// links in three groups that open on phones, the social marks, then the company details. No moving strip. The photo is
// an <img> (not a CSS background) so it loads only when the visitor nears the end of the page.
const socialIcon: Record<string, string> = {
  TikTok: '<path fill="currentColor" d="M16.6 2.5c.4 2.6 2 4.3 4.6 4.6v3.3c-1.7 0-3.3-.5-4.6-1.4v6.7a5.9 5.9 0 1 1-5.9-5.9l1 .1v3.4a2.6 2.6 0 1 0 1.7 2.4V2.5h3.2Z"/>',
  Instagram:
    '<path fill="currentColor" fill-rule="evenodd" d="M7.6 2.5h8.8a5.1 5.1 0 0 1 5.1 5.1v8.8a5.1 5.1 0 0 1-5.1 5.1H7.6a5.1 5.1 0 0 1-5.1-5.1V7.6a5.1 5.1 0 0 1 5.1-5.1Zm4.4 4.6a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8Zm0 2.1a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6Zm5.4-3.6a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4Z"/>',
  Snapchat:
    '<path fill="currentColor" d="M12 2.6c3.2 0 5.3 2.3 5.3 5.5v2.3l1.6-.6c.8-.2 1.3.7.7 1.2-.8.6-1.7.9-2.1 1.1.5 1.9 2.1 3.3 3.8 3.8.6.2.5 1-.1 1.1-1 .2-1.7.4-2 1.1-.2.6-1 .5-2 .4-1.1-.1-2.1 1-5.2 1s-4.1-1.1-5.2-1c-1 .1-1.8.2-2-.4-.3-.7-1-.9-2-1.1-.6-.1-.7-.9-.1-1.1 1.7-.5 3.3-1.9 3.8-3.8-.4-.2-1.3-.5-2.1-1.1-.6-.5-.1-1.4.7-1.2l1.6.6V8.1c0-3.2 2.1-5.5 5.3-5.5Z"/>',
};
---

<footer class="site-footer">
  <img class="footer-photo" src="/img/editorial/footer-bow-800.webp" srcset="/img/editorial/footer-bow-800.webp 800w, /img/editorial/footer-bow-1600.webp 1600w" sizes="100vw" alt="" width="1600" height="1600" loading="lazy" decoding="async" />
  <div class="footer-main">
    <div class="wrap">
      <details class="footer-group">
        <summary>{ar ? "تسوّقي" : "Shop"}</summary>
        <ul>
          <li><a href={beltsUrl(lang)}>{ar ? "كل أحزمة الخصر" : "All waist belts"}</a></li>
          {styles.map((s) => <li><a href={beltsUrl(lang, s.id)}>{styleText(lang, s.id).name}</a></li>)}
        </ul>
      </details>
      <details class="footer-group">
        <summary>{ar ? "الشركة" : "Company"}</summary>
        <ul>
          <li><a href={langPath(lang, "/about/")}>{ar ? "من نحن" : "About us"}</a></li>
          <li><a href={langPath(lang, "/contact/")}>{ar ? "تواصلي معنا" : "Contact"}</a></li>
          <li><a href={langPath(lang, "/faq/")}>{ar ? "الأسئلة الشائعة" : "FAQ"}</a></li>
          <li><a href={`mailto:${site.email}`}>{ar ? "تجار الجملة" : "Wholesale"}</a></li>
        </ul>
      </details>
      <details class="footer-group">
        <summary>{ar ? "السياسات" : "Boring stuff"}</summary>
        <ul>
          {POLICY_IDS.map((id) => <li><a href={policyPath(lang, id)}>{getPolicy(id).title}</a></li>)}
          <li><button type="button" class="footer-cookies" data-cookie-settings>{ar ? "إعدادات الكوكيز" : "Cookie settings"}</button></li>
        </ul>
      </details>
      <div class="footer-social">
        {site.social.map((s) => (
          <a class={`soc soc-${s.label.toLowerCase()}`} href={s.href} rel="noopener noreferrer" aria-label={s.label}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" set:html={socialIcon[s.label] ?? ""} /></a>
        ))}
      </div>
    </div>
  </div>

  <div class="footer-base">
    <div class="wrap">
      <a class="brand" href={langPath(lang, "/")}><Logo size={28} light /></a>
      <p>{ar ? site.legalNameAr : site.legalNameEn} · {ar ? "سجل تجاري" : "Commercial register"} <bdi dir="ltr">{site.commercialRegister}</bdi> · {ar ? "رقم التسجيل الضريبي" : "Tax no."} <bdi dir="ltr">{site.taxNumber}</bdi></p>
      <p>{ar ? site.addressAr : site.addressEn} · <a href={`mailto:${site.supportEmail}`}>{site.supportEmail}</a></p>
      <p class="signature" lang="en" dir="ltr">
        <span>© Vicuna · Designed by</span>
        <img src="/img/signature-600.webp" srcset="/img/signature-600.webp 600w, /img/signature-1200.webp 1200w" sizes="160px" width="600" height="87" alt="Khaled Elaraby" loading="lazy" decoding="async" />
      </p>
    </div>
  </div>
</footer>

<script>
  // On wide screens the three groups stand open side by side; on phones they open with a tap.
  const wide = matchMedia("(min-width: 900px)");
  const fit = () => document.querySelectorAll<HTMLDetailsElement>(".footer-group").forEach((d) => (d.open = wide.matches));
  fit();
  wide.addEventListener("change", fit);
</script>
