---
import Logo from "./ui/Logo.astro";
import { POLICY_IDS, getPolicy, policyPath } from "../policies/index.ts";
import { JOURNAL_PATH, langPath, site } from "../site.ts";
import { beltsUrl, styleText, styles } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
// Solid glyphs (no circles), like the reference the owner chose.
const socialIcon: Record<string, string> = {
  TikTok: '<path fill="currentColor" d="M16.6 2.5c.4 2.6 2 4.3 4.6 4.6v3.3c-1.7 0-3.3-.5-4.6-1.4v6.7a5.9 5.9 0 1 1-5.9-5.9l1 .1v3.4a2.6 2.6 0 1 0 1.7 2.4V2.5h3.2Z"/>',
  Instagram:
    '<path fill="currentColor" fill-rule="evenodd" d="M7.6 2.5h8.8a5.1 5.1 0 0 1 5.1 5.1v8.8a5.1 5.1 0 0 1-5.1 5.1H7.6a5.1 5.1 0 0 1-5.1-5.1V7.6a5.1 5.1 0 0 1 5.1-5.1Zm4.4 4.6a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8Zm0 2.1a2.8 2.8 0 1 1 0 5.6 2.8 2.8 0 0 1 0-5.6Zm5.4-3.6a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4Z"/>',
  Snapchat:
    '<path fill="currentColor" d="M12 2.6c3.2 0 5.3 2.3 5.3 5.5v2.3l1.6-.6c.8-.2 1.3.7.7 1.2-.8.6-1.7.9-2.1 1.1.5 1.9 2.1 3.3 3.8 3.8.6.2.5 1-.1 1.1-1 .2-1.7.4-2 1.1-.2.6-1 .5-2 .4-1.1-.1-2.1 1-5.2 1s-4.1-1.1-5.2-1c-1 .1-1.8.2-2-.4-.3-.7-1-.9-2-1.1-.6-.1-.7-.9-.1-1.1 1.7-.5 3.3-1.9 3.8-3.8-.4-.2-1.3-.5-2.1-1.1-.6-.5-.1-1.4.7-1.2l1.6.6V8.1c0-3.2 2.1-5.5 5.3-5.5Z"/>',
};
---

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <a class="brand" href={langPath(lang, "/")} aria-label={ar ? "فيكونا - الرئيسية" : "Vicuna - Home"}><Logo /></a>
      <p>{ar ? "فيكونا علامة مصرية، نصنع منتجاتنا بأيدينا ونوصّلها إلى جميع محافظات مصر." : "Vicuna is an Egyptian brand. We make our products by hand and deliver them across Egypt."}</p>
    </div>
    <div>
      <h3 class="footer-h">{ar ? "الأحزمة" : "Belts"}</h3>
      <ul>
        <li><a href={beltsUrl(lang)}>{ar ? "كل الأحزمة" : "All belts"}</a></li>
        {styles.map((s) => <li><a href={beltsUrl(lang, s.id)}>{styleText(lang, s.id).name}</a></li>)}
        {ar && <li><a href={JOURNAL_PATH}>المقالات</a></li>}
      </ul>
    </div>
    <div>
      <h3 class="footer-h">{ar ? "المساعدة" : "Help"}</h3>
      <ul>
        <li><a href={langPath(lang, "/about/")}>{ar ? "من نحن" : "About us"}</a></li>
        <li><a href={langPath(lang, "/contact/")}>{ar ? "تواصلي معنا" : "Contact us"}</a></li>
        <li><a href={langPath(lang, "/faq/")}>{ar ? "الأسئلة الشائعة" : "FAQ"}</a></li>
        {POLICY_IDS.map((id) => <li><a href={policyPath(lang, id)}>{getPolicy(id, lang).title}</a></li>)}
        <li><button type="button" class="footer-cookies" data-cookie-settings>{ar ? "إعدادات الكوكيز" : "Cookie settings"}</button></li>
      </ul>
    </div>
  </div>

  <div class="wrap footer-social">
    {site.social.map((s) => (
      <a href={s.href} rel="noopener noreferrer" aria-label={s.label}><svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" set:html={socialIcon[s.label] ?? ""} /></a>
    ))}
  </div>

  <div class="wrap footer-legal">
    <p>
      {ar ? site.legalNameAr : site.legalNameEn} · {ar ? "سجل تجاري" : "Commercial register"} <bdi dir="ltr">{site.commercialRegister}</bdi> · {ar ? "رقم التسجيل الضريبي" : "Tax registration no."} <bdi dir="ltr">{site.taxNumber}</bdi><br />
      {ar ? site.addressAr : site.addressEn}
    </p>
    <p class="operated" lang="en" dir="ltr">© Website is operated by {site.legalNameEn}, trading as vicuna-eg</p>
    <p class="signature" lang="en" dir="ltr">
      <span>Designed by</span>
      <img src="/img/signature-600.webp" srcset="/img/signature-600.webp 600w, /img/signature-1200.webp 1200w" sizes="200px" width="600" height="87" alt="Khaled Elaraby" loading="lazy" decoding="async" />
    </p>
  </div>
</footer>
