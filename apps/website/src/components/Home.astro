---
// The home page (owner, 2026-10-19: the layout of the quiet fashion store he showed; this replaces ADR 0009's "no
// product grid on /"). The film fills the screen with a short line over it; then the newest belts as cards, a one-line
// brand note, two designs as large photos, every belt by design behind tabs, and a quiet closing photo. Few words.
import ProductCard from "./ProductCard.astro";
import { HOME_FILM } from "../lib/designs.ts";
import { lookOf } from "../lib/looks.ts";
import { langPath } from "../site.ts";
import { beltsUrl, getProduct, productName, products, styleText, styles } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
const t = ar
  ? { kicker: "أحزمة الخصر", title: "تكمّل كل لبسة", discover: "اكتشفي أكتر", newIn: "وصل حديثًا", viewAll: "شوفي الكل", note: "أحزمة خصر بنصنعها بإيدينا في القاهرة، علشان تكمّل أي لبسة.", about: "من نحن", shop: "تسوّقي", all: "الكل", closing: "مصنوعة في القاهرة" }
  : { kicker: "Waist belts", title: "Made to finish the look", discover: "Discover more", newIn: "Just arrived", viewAll: "View all", note: "Waist belts we make by hand in Cairo, so every outfit feels finished.", about: "About us", shop: "Shop", all: "All", closing: "Made in Cairo" };
const newest = products.filter((p) => p.style !== "pattern").slice(0, 8);
// Every photo leads to the belt in it (owner, 2026-10-19): two on-model photos, each opening its own product page.
const tiles = ["lace-white", "wide-tie-mustard"].flatMap((id) => {
  const p = getProduct(id);
  const look = p ? lookOf(p) : null;
  return p && look ? [{ href: beltsUrl(lang, p.id), name: productName(lang, p), look }] : [];
});
---

<section class="hero">
  <video class="hero-media" data-motion src={`${HOME_FILM}.mp4`} poster={`${HOME_FILM}.webp`} muted loop playsinline preload="metadata" aria-hidden="true" width="704" height="1280"></video>
  <div class="hero-text">
    <p class="kicker">{t.kicker}</p>
    <h1 class="hero-title">{t.title}</h1>
    <a class="text-btn" href={beltsUrl(lang)}>{t.discover}</a>
  </div>
</section>

<section class="sx-section sx-soft">
  <div class="wrap">
    <div class="sx-head">
      <h2 class="sx-h">{t.newIn}</h2>
      <a class="text-btn" href={beltsUrl(lang)}>{t.viewAll}</a>
    </div>
    <div class="card-row">
      {newest.map((p, i) => <ProductCard product={p} lang={lang} index={i} />)}
    </div>
  </div>
</section>

<section class="sx-note wrap">
  <p>{t.note}</p>
  <a class="text-btn" href={langPath(lang, "/about/")}>{t.about}</a>
</section>

<section class="sx-tiles">
  {tiles.map((x) => (
    <a class="sx-tile" href={x.href}>
      <img src={x.look.src} srcset={x.look.srcset} sizes="(min-width: 900px) 50vw, 100vw" alt={x.name} width="640" height="800" loading="lazy" decoding="async" />
      <span class="text-btn">{t.shop} {x.name}</span>
    </a>
  ))}
</section>

<section class="sx-section">
  <div class="wrap">
    <div class="sx-tabs" role="tablist" aria-label={ar ? "التصميمات" : "Designs"}>
      <button type="button" role="tab" aria-selected="true" data-tab="all">{t.all}</button>
      {styles.map((s) => <button type="button" role="tab" aria-selected="false" data-tab={s.id}>{styleText(lang, s.id).name}</button>)}
    </div>
    <div class="card-grid" data-tab-grid>
      {products.map((p, i) => <ProductCard product={p} lang={lang} index={i} />)}
    </div>
  </div>
</section>

<a class="sx-banner" href={beltsUrl(lang, "lace-white")}>
  <img src="/img/editorial/lace-close-1600.webp" srcset="/img/editorial/lace-close-800.webp 800w, /img/editorial/lace-close-1600.webp 1600w" sizes="100vw" alt="" width="1600" height="1200" loading="lazy" decoding="async" />
  <p class="sx-banner-text">{t.closing}</p>
</a>

<script>
  // Design tabs: show the belts of one design (or all) in the grid under them.
  const tabs = document.querySelectorAll<HTMLButtonElement>("[data-tab]");
  const grid = document.querySelector<HTMLElement>("[data-tab-grid]");
  tabs.forEach((tab) =>
    tab.addEventListener("click", () => {
      const id = tab.dataset["tab"];
      tabs.forEach((x) => x.setAttribute("aria-selected", String(x === tab)));
      grid?.querySelectorAll<HTMLElement>("article.card").forEach((c) => (c.hidden = id !== "all" && c.dataset["style"] !== id));
    }),
  );
</script>
