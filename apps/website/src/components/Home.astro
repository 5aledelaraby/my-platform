---
// The home page (vicuna-eg.com): a calm introduction to Vicuna, not a belts page. Images are editorial
// photos. It never shows the product grid or cart UI (ADR 0009); the belts are one of the sections.
import ContactCards from "./ContactCards.astro";
import Icon from "./ui/Icon.astro";
import { JOURNAL_PATH, langPath, site } from "../site.ts";
import { beltsUrl } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
const customWa = `https://wa.me/${site.whatsappInternational}?text=${encodeURIComponent(ar ? "أهلاً فيكونا، أرغب في حزام جلد طبيعي مفصّل على مقاسي." : "Hello Vicuna, I would like a made-to-measure natural leather belt.")}`;

const values = ar
  ? [
      { t: "التصميم", d: "خطوط بسيطة وألوان هادئة، تناسب يومكِ وتعيش معكِ طويلًا." },
      { t: "الصنعة", d: "نصنع منتجاتنا بأيدينا، ونراجع كل قطعة قبل أن تصل إليكِ." },
      { t: "القرب منكِ", d: "نرد على أسئلتكِ بأنفسنا، ونوصّل إلى جميع محافظات مصر." },
    ]
  : [
      { t: "Design", d: "Simple lines and calm colours that suit your day and last." },
      { t: "Craft", d: "We make our products by hand and check every piece before it reaches you." },
      { t: "Close to you", d: "We answer your questions ourselves and deliver across Egypt." },
    ];

interface Section { title: string; text: string; href: string; external?: boolean }
const sections: Section[] = [
  {
    title: ar ? "الأحزمة" : "Belts",
    text: ar ? "تصميمات من جلد PU والدانتيل بألوان كثيرة." : "Designs in PU leather and lace, in many colours.",
    href: beltsUrl(lang),
  },
  {
    title: ar ? "التفصيل على المقاس" : "Made to measure",
    text: ar ? "أحزمة من الجلد الطبيعي تُفصّل على مقاسكِ، في القاهرة والجيزة." : "Natural leather belts made to your size, in Cairo and Giza.",
    href: customWa,
    external: true,
  },
  ...(ar ? [{ title: "المقالات", text: "أفكار للتنسيق والاختيار.", href: JOURNAL_PATH }] : []),
];
---

<section class="intro-hero">
  <figure class="intro-cover">
    <video id="home-film" src="/video/home.mp4" poster="/video/home.webp" autoplay muted loop playsinline preload="metadata" width="540" height="982"></video>
    <button type="button" class="film-sound" data-film-sound aria-pressed="false">{ar ? "تشغيل الصوت" : "Sound on"}</button>
  </figure>
  <div class="wrap intro-text">
    <p class="intro-kicker" lang="en">VICUNA</p>
    <h1>{ar ? "تصميمات بسيطة، تُصنع بعناية" : "Simple designs, made with care"}</h1>
    <p class="lead">{ar ? "فيكونا علامة مصرية للتجارة العامة والتصميمات. نصمّم ونصنع بأيدينا، ونهتم بالتفاصيل الصغيرة." : "Vicuna is an Egyptian trading and design brand. We design and make by hand, and we care about the small details."}</p>
  </div>
</section>

<section class="wrap intro-split reveal">
  <figure class="intro-photo"><img src="/img/editorial/model-seated-640.webp" srcset="/img/editorial/model-seated-640.webp 640w, /img/editorial/model-seated-1200.webp 1200w" sizes="(min-width: 900px) 45vw, 100vw" alt="" width="640" height="800" loading="lazy" decoding="async" /></figure>
  <div class="intro-copy">
    <h2>{ar ? "من نحن" : "About us"}</h2>
    <p>
      {ar
        ? `${site.legalNameAr} علامة مصرية مقرها القاهرة. نؤمن بأن القطعة الجيدة تبدأ من تصميم واضح وخامة مختارة وصنعة متأنية، ولهذا نصنع منتجاتنا بأيدينا ونراجع كل قطعة قبل أن تصل إليكِ.`
        : `${site.legalNameEn} is an Egyptian brand based in Cairo. We believe a good piece starts with a clear design, a chosen material and patient craft, so we make our products by hand and check every piece before it reaches you.`}
    </p>
    <ul class="intro-values">
      {values.map((v) => <li><b>{v.t}</b><span>{v.d}</span></li>)}
    </ul>
  </div>
</section>

<section class="wrap intro-split flip reveal">
  <figure class="intro-photo"><img src="/img/editorial/model-blazer-640.webp" srcset="/img/editorial/model-blazer-640.webp 640w, /img/editorial/model-blazer-1200.webp 1200w" sizes="(min-width: 900px) 45vw, 100vw" alt="" width="640" height="800" loading="lazy" decoding="async" /></figure>
  <div class="intro-copy">
    <h2>{ar ? "أقسامنا" : "Our sections"}</h2>
    <ul class="section-links">
      {sections.map((s) => (
        <li>
          <a href={s.href} rel={s.external ? "noopener noreferrer" : undefined}>
            <span><b>{s.title}</b><span class="muted">{s.text}</span></span>
            <Icon name="arrow" size={18} class="dir-icon" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="wrap intro-contact reveal">
  <h2>{ar ? "تواصلي مع فريقنا" : "Contact our team"}</h2>
  <p class="muted">{ar ? "عندكِ سؤال؟ نحن هنا لمساعدتكِ." : "Have a question? We are here to help."}</p>
  <ContactCards lang={lang} compact />
  <p><a class="textlink" href={langPath(lang, "/contact/")}>{ar ? "كل طرق التواصل" : "All the ways to reach us"}</a></p>
</section>

<script>
  // Browsers only autoplay muted video; the visitor turns the sound on with this button.
  const film = document.getElementById("home-film") as HTMLVideoElement | null;
  const sound = document.querySelector<HTMLButtonElement>("[data-film-sound]");
  if (film && sound) {
    const on = document.documentElement.lang === "ar" ? "إيقاف الصوت" : "Sound off";
    const off = sound.textContent ?? "";
    sound.addEventListener("click", () => {
      film.muted = !film.muted;
      if (!film.muted) void film.play();
      sound.setAttribute("aria-pressed", String(!film.muted));
      sound.textContent = film.muted ? off : on;
    });
  }
</script>
