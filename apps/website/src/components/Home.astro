---
import { homeCopy } from "../home-copy.ts";
import { site, langPath } from "../site.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeCopy[lang];
const wa = `https://wa.me/${site.whatsappInternational}`;
---

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow">{c.eyebrow}</span>
      <h1>{c.h1a} <span>{c.h1b}</span></h1>
      <p class="lead">{c.lead}</p>
      <div class="hero-actions">
        <a class="btn" href={langPath(lang, "/belts/")}>{c.cta}</a>
        <a class="btn ghost" href={wa} rel="noopener noreferrer">{c.ctaWhatsapp}</a>
      </div>
    </div>
    <div class="hero-photo">
      <img src="/img/hero.jpg" alt={c.heroAlt} width="1600" height="1080" fetchpriority="high" />
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap perks">
    {c.perks.map((p) => <div class="perk"><b>{p.t}</b><span>{p.d}</span></div>)}
  </div>
</section>

<section class="section">
  <div class="wrap split">
    <div>
      <span class="eyebrow">{c.handEyebrow}</span>
      <h2>{c.handTitle}</h2>
      <p class="muted">{c.handBody}</p>
      <div class="founder">
        <img src="/img/founder.jpg" alt="" width="160" height="160" loading="lazy" />
        <div><b>{c.founderName}</b><br /><span class="muted">{c.founderRole}</span></div>
      </div>
    </div>
    <img src="/img/founder-collage.jpg" alt={c.collageAlt} width="2400" height="1245" loading="lazy" />
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="tease">
      <span class="eyebrow">{c.bespokeEyebrow}</span>
      <h2 style="margin:8px 0 10px">{c.bespokeTitle}</h2>
      <p class="muted">{c.bespokeBody}</p>
      <div class="hero-actions"><a class="btn" href={wa} rel="noopener noreferrer">{c.ctaWhatsapp}</a></div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap block">
    <h2>{c.linksTitle}</h2>
    <div class="links">
      {c.links.map((l) => <a href={langPath(lang, l.href)}>{l.t}<small>{l.d}</small></a>)}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap block faq">
    <h2>{c.faqTitle}</h2>
    {c.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </div>
</section>
