---
// The home page (vicuna-eg.com): a calm introduction to Vicuna, black on white and few words (owner, 2026-10-16).
// It never shows the product grid or cart UI (ADR 0009): the designs appear as plain links to their pages, all of
// them alike.
import Icon from "./ui/Icon.astro";
import SpiralArrow from "./ui/SpiralArrow.astro";
import { leadOf } from "../lib/designs.ts";
import { langPath, site } from "../site.ts";
import { beltsUrl, styleText, styles } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
const designs = styles.map((s) => ({ id: s.id, name: styleText(lang, s.id).name, img: leadOf(s.id, lang).img }));
const title = (ar ? "حزام الوسط اللي يفرق في كل لبسة" : "The waist belt that makes every outfit").split(" ");
const wa = `https://wa.me/${site.whatsappInternational}`;
---

<section class="intro-hero bw-hero">
  <figure class="intro-cover">
    <video id="home-film" data-motion src="/video/pattern-brown.mp4" poster="/video/pattern-brown.webp" muted loop playsinline preload="metadata" width="704" height="1280"></video>
    <button type="button" class="film-sound" data-film-sound aria-pressed="false">{ar ? "تشغيل الصوت" : "Sound on"}</button>
  </figure>
  <div class="wrap intro-text">
    <p class="intro-kicker" lang="en">VICUNA</p>
    <h1 class="wl-title bw-title">{title.map((w, i) => <span class="wl-word" style={`--w:${i}`}>{w} </span>)}</h1>
    <p class="lead wl-word" style={`--w:${title.length + 1}`}>{ar ? "فيكونا علامة تجارية مميزة في تصنيع الجلود، وخدمات بناء المواقع والسوشيال ميديا." : "Vicuna is a distinctive brand in leather making, website building and social media services."}</p>
    <div class="hero-actions wl-word" style={`--w:${title.length + 2}`}>
      <a class="btn" href={beltsUrl(lang)}>{ar ? "تسوّقي أحزمة الخصر" : "Shop waist belts"}</a>
    </div>
  </div>
</section>

<section class="wrap bw-designs reveal">
  <div class="bw-head">
    <h2>{ar ? "أحزمة الخصر" : "Waist belts"}</h2>
    <a class="wl-cta" href={beltsUrl(lang)}>{ar ? "شوفيها كلها" : "See them all"} <SpiralArrow /></a>
  </div>
  <div class="bw-row">
    {designs.map((d) => (
      <a class="bw-tile" href={beltsUrl(lang, d.id)}>
        <img src={d.img.src} srcset={d.img.srcset} sizes="(min-width: 900px) 18vw, 42vw" alt="" width={d.img.w} height={d.img.h} loading="lazy" decoding="async" />
        <span>{d.name}</span>
      </a>
    ))}
  </div>
</section>

<section class="wrap bw-lines reveal">
  <div>
    <h2>{ar ? "من نحن" : "About us"}</h2>
    <p>{ar ? "علامة مصرية من القاهرة، بنصمم منتجات يدوية ومواقع إلكترونية." : "An Egyptian brand from Cairo: handmade products and websites."} <a class="textlink" href={langPath(lang, "/about/")}>{ar ? "اعرفي أكتر" : "More"}</a></p>
  </div>
  <div>
    <h2>{ar ? "لتجار الجملة" : "Wholesale"}</h2>
    <p><a class="textlink" href={`mailto:${site.email}`}><bdi dir="ltr">{site.email}</bdi></a></p>
  </div>
  <div>
    <h2>{ar ? "تواصلي معنا" : "Contact us"}</h2>
    <p class="bw-contact">
      <a class="btn" href={wa} rel="noopener noreferrer"><Icon name="whatsapp" size={18} /> {ar ? "واتساب" : "WhatsApp"}</a>
      <a class="textlink" href={langPath(lang, "/contact/")}>{ar ? "كل طرق التواصل" : "All the ways to reach us"}</a>
    </p>
  </div>
</section>

<script>
  // Browsers only autoplay muted video; the visitor turns the sound on with this button.
  const film = document.getElementById("home-film") as HTMLVideoElement | null;
  const sound = document.querySelector<HTMLButtonElement>("[data-film-sound]");
  if (film && sound) {
    const on = document.documentElement.lang === "ar" ? "إيقاف الصوت" : "Sound off";
    const off = sound.textContent ?? "";
    sound.addEventListener("click", () => {
      film.muted = !film.muted;
      if (!film.muted) void film.play();
      sound.setAttribute("aria-pressed", String(!film.muted));
      sound.textContent = film.muted ? off : on;
    });
  }
</script>
