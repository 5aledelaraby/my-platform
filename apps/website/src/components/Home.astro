---
// The home page (owner, 2026-10-19, ADR 0015): light and simple, not a sales page. Every photo leads to the belt in
// it, and the belts are bought on the belts and product pages. From the top: the white-dress photo with the signature
// pattern belt, one line about the brand, the lace white photo, then the designs as large words with their on-model
// photos in a row that slides sideways (the layout of the store he showed), and a link to all the belts.
// Slides are <article class="card ..." data-product>, so the site Worker removes a sold-out belt's photos (ADR 0013).
import { getProduct, beltsUrl, priceOfProduct, productName, products, styleText, styles } from "../store.ts";
import { looksOf } from "../lib/looks.ts";
import type { Look } from "../lib/looks.ts";
import { langPath } from "../site.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;

const photo = (id: string, n: number): { href: string; name: string; look: Look } => {
  const p = getProduct(id);
  const look = p ? looksOf(p)[n - 1] : undefined;
  if (!p || !look) throw new Error(`Home: no photo ${n} for ${id}`);
  return { href: beltsUrl(lang, p.id), name: productName(lang, p), look };
};
const hero = photo("pattern-brown", 3);
const lace = photo("lace-white", 1);

// Every on-model photo of every belt, grouped by design; designs without one are left out.
const rows = styles
  .map((s) => ({
    id: s.id,
    name: styleText(lang, s.id).name,
    slides: products
      .filter((p) => p.style === s.id)
      .flatMap((p) => looksOf(p).map((look) => ({ p, look, name: productName(lang, p), href: beltsUrl(lang, p.id), price: priceOfProduct(p) }))),
  }))
  .filter((r) => r.slides.length > 0);
---

<section class="home-hero">
  <a class="home-hero-photo" href={hero.href} aria-label={hero.name}>
    <img src={hero.look.src} srcset={hero.look.srcset} sizes="100vw" alt={`${hero.name}, worn with a white dress`} width="1200" height="1500" fetchpriority="high" decoding="async" />
  </a>
  <div class="home-hero-text">
    <p class="kicker">Waist belts</p>
    <h1>Made to finish the look</h1>
    <a class="text-btn" href={beltsUrl(lang)}>Discover more</a>
  </div>
</section>

<section class="home-note wrap">
  <p>Waist belts we make by hand in Cairo, so every outfit feels finished.</p>
  <a class="text-btn" href={langPath(lang, "/about/")}>About us</a>
</section>

<section class="home-feature">
  <a href={lace.href} aria-label={lace.name}>
    <img src={lace.look.src} srcset={lace.look.srcset} sizes="(min-width: 900px) 50vw, 100vw" alt={`${lace.name}, worn with a white satin dress`} width="640" height="800" loading="lazy" decoding="async" />
  </a>
  <a class="text-btn" href={lace.href}>{lace.name}</a>
</section>

<section class="looks" aria-label="Designs">
  <div class="looks-tabs" role="tablist">
    {rows.map((r, i) => <button type="button" role="tab" id={`looks-tab-${r.id}`} aria-controls={`looks-${r.id}`} aria-selected={i === 0 ? "true" : "false"} data-looks-tab={r.id}>{r.name}</button>)}
  </div>
  {rows.map((r, i) => (
    <div class="looks-row" id={`looks-${r.id}`} role="tabpanel" aria-labelledby={`looks-tab-${r.id}`} data-looks-row={r.id} hidden={i > 0}>
      {r.slides.map((s) => (
        <article class="card look-card" data-product={s.p.id}>
          <a href={s.href}>
            <img src={s.look.src} srcset={s.look.srcset} sizes="(min-width: 900px) 30vw, 78vw" alt={`${s.name}, worn`} width="640" height="800" loading="lazy" decoding="async" />
            <span class="look-name">{s.name}</span>
            <span class="look-price">LE {s.price}</span>
          </a>
        </article>
      ))}
    </div>
  ))}
  <p class="looks-more"><a class="text-btn" href={beltsUrl(lang)}>View all</a></p>
</section>

<script>
  // Design tabs: one row of photos at a time. A design whose photos were all removed (sold out) loses its tab.
  const tabs = [...document.querySelectorAll<HTMLButtonElement>("[data-looks-tab]")];
  const rowOf = (id: string | undefined) => document.querySelector<HTMLElement>(`[data-looks-row="${id}"]`);
  for (const tab of tabs) {
    const row = rowOf(tab.dataset["looksTab"]);
    if (!row?.querySelector(".look-card")) tab.hidden = true;
  }
  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute("aria-selected", String(on));
      const row = rowOf(t.dataset["looksTab"]);
      if (row) row.hidden = !on;
    }
    rowOf(tab.dataset["looksTab"])?.scrollTo({ left: 0 });
  };
  for (const tab of tabs) tab.addEventListener("click", () => select(tab));
  const first = tabs.find((t) => !t.hidden);
  if (first && first.getAttribute("aria-selected") !== "true") select(first);
</script>
