---
// The home page (vicuna-eg.com): a calm introduction to Vicuna, not a belts page. Images are editorial
// photos. It never shows the product grid or cart UI (ADR 0009); the belts are one of the sections.
import ContactCards from "./ContactCards.astro";
import Icon from "./ui/Icon.astro";
import { langPath } from "../site.ts";
import { beltsUrl } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";


interface Section { title: string; text: string; href: string; external?: boolean }
const sections: Section[] = [
  {
    title: ar ? "الأحزمة" : "Belts",
    text: ar ? "تصميمات من جلد PU والدانتيل بألوان كثيرة." : "Designs in PU leather and lace, in many colours.",
    href: beltsUrl(lang),
  },
];
---

<section class="intro-hero">
  <figure class="intro-cover">
    <video id="home-film" data-motion src="/video/pattern-brown.mp4" poster="/video/pattern-brown.webp" muted loop playsinline preload="metadata" width="704" height="1280"></video>
    <button type="button" class="film-sound" data-film-sound aria-pressed="false">{ar ? "تشغيل الصوت" : "Sound on"}</button>
  </figure>
  <div class="wrap intro-text">
    <p class="intro-kicker" lang="en">VICUNA</p>
    <h1>{ar ? "تصميمات بسيطة" : "Simple designs"}</h1>
    <p class="lead">{ar ? "فيكونا علامة مصرية للتجارة العامة والتصميمات. نصمّم ونصنع بأيدينا." : "Vicuna is an Egyptian trading and design brand. We design and make by hand."}</p>
    <div class="hero-actions">
      <a class="btn" href={beltsUrl(lang)}>{ar ? "تسوّقي الأحزمة" : "Shop the belts"}</a>
      <a class="btn btn-white" href={beltsUrl(lang, "pattern")}>{ar ? "حزام بنقشة مميزة" : "The signature pattern belt"}</a>
    </div>
  </div>
</section>

<section class="wrap intro-split text-only reveal">
  <div class="intro-copy">
    <h2>{ar ? "من نحن" : "About us"}</h2>
    <p>
      {ar
        ? "فيكونا ديزاينز علامة مصرية مقرها القاهرة، نعمل في التصميم بأشكاله المختلفة: من المنتجات والإكسسوارات المصنوعة يدويًا، إلى تصميم المواقع الإلكترونية وبنائها."
        : "Vicuna Designs is an Egyptian brand based in Cairo. We work across design: from handmade products and accessories to designing and building websites."}
    </p>
    <p><a class="textlink" href={langPath(lang, "/about/")}>{ar ? "اعرفي المزيد عنّا" : "More about us"}</a></p>
  </div>
</section>

<section class="wrap intro-split text-only reveal">
  <div class="intro-copy">
    <h2>{ar ? "أقسامنا" : "Our sections"}</h2>
    <ul class="section-links">
      {sections.map((s) => (
        <li>
          <a href={s.href} rel={s.external ? "noopener noreferrer" : undefined}>
            <span><b>{s.title}</b><span class="muted">{s.text}</span></span>
            <Icon name="arrow" size={18} class="dir-icon" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="wrap intro-contact reveal">
  <h2>{ar ? "تواصلي مع فريقنا" : "Contact our team"}</h2>
  <p class="muted">{ar ? "عندكِ سؤال؟ نحن هنا لمساعدتكِ." : "Have a question? We are here to help."}</p>
  <ContactCards lang={lang} compact />
  <p><a class="textlink" href={langPath(lang, "/contact/")}>{ar ? "كل طرق التواصل" : "All the ways to reach us"}</a></p>
</section>

<script>
  // Browsers only autoplay muted video; the visitor turns the sound on with this button.
  const film = document.getElementById("home-film") as HTMLVideoElement | null;
  const sound = document.querySelector<HTMLButtonElement>("[data-film-sound]");
  if (film && sound) {
    const on = document.documentElement.lang === "ar" ? "إيقاف الصوت" : "Sound off";
    const off = sound.textContent ?? "";
    sound.addEventListener("click", () => {
      film.muted = !film.muted;
      if (!film.muted) void film.play();
      sound.setAttribute("aria-pressed", String(!film.muted));
      sound.textContent = film.muted ? off : on;
    });
  }
</script>
