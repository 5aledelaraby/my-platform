---
// The home page: a short introduction to Vicuna and its sections. It never shows the product grid or cart UI
// (ADR 0009); the belts have their own landing page (/belts/) and catalogue (/belts/shop/).
import Icon from "./ui/Icon.astro";
import { site } from "../site.ts";
import { beltsUrl, getProduct, shopUrl, thumbOf } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
const wa = `https://wa.me/${site.whatsappInternational}`;
const customWa = `${wa}?text=${encodeURIComponent(ar ? "أهلاً فيكونا، أرغب في حزام جلد طبيعي مفصّل على مقاسي." : "Hello Vicuna, I would like a made-to-measure natural leather belt.")}`;
const floaters = [
  { id: "bow-white", pos: "f2", r: "8deg", d: "-1.6s" },
  { id: "lace-red", pos: "f3", r: "-6deg", d: "-4.4s" },
].flatMap((f) => {
  const p = getProduct(f.id);
  return p ? [{ ...f, src: thumbOf(p) }] : [];
});

interface Area {
  title: string;
  text: string;
  cta: string;
  href: string;
  img: string;
  size: [number, number];
  alt: string;
  external?: boolean;
}
const areas: Area[] = [
  {
    title: ar ? "الأحزمة" : "Belts",
    text: ar ? "ستة تصاميم من جلد PU والدانتيل، بألوان كثيرة، توصيل لكل مصر." : "Six designs in PU leather and lace, in many colours, delivered across Egypt.",
    cta: ar ? "ادخلي إلى الأحزمة" : "Explore the belts",
    href: beltsUrl(lang),
    img: "/img/mood-bow.webp",
    size: [900, 900],
    alt: ar ? "حزام فيونكة من فيكونا على فستان" : "A Vicuna bow belt on a dress",
  },
  {
    title: ar ? "التفصيل على المقاس" : "Made to measure",
    text: ar
      ? "أحزمة من الجلد الطبيعي تُفصّل على مقاسكِ وبالتصميم الذي تختارينه، في القاهرة والجيزة."
      : "Natural leather belts made to your size and the design you choose, in Cairo and Giza.",
    cta: ar ? "اطلبي على واتساب" : "Ask on WhatsApp",
    href: customWa,
    img: "/img/leather-600.webp",
    size: [600, 450],
    alt: ar ? "جلود طبيعية بألوان مختلفة في الورشة" : "Natural leather hides in different colours in the workshop",
    external: true,
  },
  ...(ar
    ? [
        {
          title: "المقالات",
          text: "أفكار لتنسيق الحزام مع ملابسكِ، واختيار المقاس والخامة المناسبة.",
          cta: "اقرئي المقالات",
          href: "/blog/",
          img: "/img/mood-lace.webp",
          size: [900, 900] as [number, number],
          alt: "حزام دانتيل من فيكونا",
        },
      ]
    : []),
];
---

<section class="hero intro">
  <div class="hero-box">
    <div class="hero-text">
      <p class="hero-tagline">{ar ? "صُنع في مصر" : "Made in Egypt"}</p>
      <h1>{ar ? <>فيكونا<br /><span class="accent">أحزمة نصنعها بأيدينا</span></> : <>Vicuna<br /><span class="accent">belts we make by hand</span></>}</h1>
      <p class="lead">
        {ar
          ? "علامة مصرية لأحزمة الخصر النسائية. نقصّ كل حزام بالليزر ونخيطه يدويًا، ونوصّله إلى جميع محافظات مصر."
          : "An Egyptian brand of women's waist belts. We laser-cut and hand-sew every belt, and deliver to every governorate in Egypt."}
      </p>
      <div class="hero-actions">
        <a class="btn btn-berry btn-shine" href={beltsUrl(lang)}>{ar ? "ادخلي إلى الأحزمة" : "Explore the belts"} <Icon name="arrow" size={18} class="dir-icon" /></a>
        <a class="btn btn-white" href={shopUrl(lang)}>{ar ? "تسوّقي مباشرة" : "Shop now"}</a>
      </div>
    </div>
    <div class="hero-art">
      <span class="hero-glow" aria-hidden="true"></span>
      <figure class="arch">
        <img
          src="/img/hero-1200.webp"
          srcset="/img/hero-800.webp 800w, /img/hero-1200.webp 1200w"
          sizes="(min-width: 960px) 40vw, 80vw"
          alt={ar ? "أحزمة خصر من فيكونا على مجسّمات عرض" : "Vicuna waist belts on display mannequins"}
          width="1200"
          height="810"
          fetchpriority="high"
          decoding="async"
        />
      </figure>
      {floaters.map((f) => (
        <img class={`floaty ${f.pos}`} src={f.src} alt="" aria-hidden="true" width="480" height="480" decoding="async" style={`--r:${f.r};--d:${f.d}`} />
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{ar ? "أقسام فيكونا" : "Vicuna"}</p>
      <h2 class="h2">{ar ? "من أين تبدئين؟" : "Where would you like to start?"}</h2>
    </div>
    <div class="areas">
      {areas.map((a, i) => (
        <a class="area-card reveal" href={a.href} style={`--i:${i}`} rel={a.external ? "noopener noreferrer" : undefined}>
          <span class="area-media"><img src={a.img} alt={a.alt} width={a.size[0]} height={a.size[1]} loading="lazy" decoding="async" /></span>
          <span class="area-body">
            <span class="area-title">{a.title}</span>
            <span class="muted">{a.text}</span>
            <span class="area-cta">{a.cta} <Icon name="arrow" size={16} class="dir-icon" /></span>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
