---
// "Style guides" on the belts, design and product pages: up to three journal guides that show these belts or link to
// them, in the page's language, and a link to the journal. Links pages to the guides and the guides back to the belts.
import { existsSync } from "node:fs";
import { join } from "node:path";
import { articlesAbout, articlesIn, articleUrl } from "../lib/articles.ts";
import { JOURNAL_PATH } from "../site.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang; ids?: readonly string[] }
const { lang, ids = [] } = Astro.props;
const ar = lang === "ar";
const about = ids.length ? articlesAbout(lang, ids) : [];
const list = (about.length ? about : articlesIn(lang)).slice(0, 3);
// The small copy of the cover when there is one (look photos have 400 px copies), else the cover itself.
const thumb = (src: string) => {
  const small = src.replace(/-1200\.webp$/, "-400.webp");
  return small !== src && existsSync(join(process.cwd(), "public", small)) ? small : src;
};
---

{list.length > 0 && (
  <section class="wrap guides" aria-labelledby="guides-title">
    <h2 class="section-title" id="guides-title">{ar ? "أفكار للتنسيق" : "Style guides"}</h2>
    <ul class="guides-list">
      {list.map((a) => (
        <li>
          <a href={articleUrl(a.slug)}>
            <img src={thumb(a.image)} alt="" width={a.imageWidth} height={a.imageHeight} loading="lazy" decoding="async" />
            <span class="guides-name">{a.title}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="guides-more"><a class="text-btn" href={JOURNAL_PATH}>{ar ? "كل المقالات" : "All guides"}</a></p>
  </section>
)}
