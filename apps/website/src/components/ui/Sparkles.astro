---
// Three small four-point stars that twinkle softly (owner, 2026-10-16: "the simple stars" of the old site).
// Decorative only; the parent must be position: relative. They stay still when the device asks for reduced motion.
interface Props { variant?: "a" | "b" }
const { variant = "a" } = Astro.props;
const star = "M12 0c.6 5.6 2.6 10.4 12 12-9.4 1.6-11.4 6.4-12 12-.6-5.6-2.6-10.4-12-12 9.4-1.6 11.4-6.4 12-12Z";
---

<span class={`sparkles sparkles-${variant}`} aria-hidden="true">
  {[1, 2, 3].map((i) => <svg class={`spk spk${i}`} viewBox="0 0 24 24"><path fill="currentColor" d={star} /></svg>)}
</span>
