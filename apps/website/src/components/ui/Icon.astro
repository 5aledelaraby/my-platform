---
// Small two-tone illustrations (red line + soft pink fill), drawn on a 48×48 grid, and a few UI icons.
// The pink comes from --il-fill, so the same art works on white or on red.
interface Props { name: "plane" | "cash" | "return" | "tape" | "tag" | "sparkle" | "arrow" | "bag" | "whatsapp"; class?: string; size?: number }
const { name, class: cls, size = 24 } = Astro.props;
const ln = 'fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"';
const soft = 'fill="var(--il-fill, #FBE8EA)"';
const art: Record<Props["name"], { box: number; body: string }> = {
  plane: { box: 48, body: `<path ${soft} d="M42 7 6 22l13 5 3 13 7-9 9 6Z"/><path ${ln} d="M42 7 6 22l13 5 3 13 7-9 9 6L42 7ZM19 27 42 7M22 40l1-10"/><path ${ln} stroke-dasharray="1 4" d="M4 34c4 2 8 2 11 0"/>` },
  cash: { box: 48, body: `<rect ${soft} x="5" y="13" width="32" height="20" rx="4"/><rect ${ln} x="5" y="13" width="32" height="20" rx="4"/><circle ${ln} cx="21" cy="23" r="4.5"/><circle ${soft} cx="37" cy="33" r="7"/><circle ${ln} cx="37" cy="33" r="7"/><path ${ln} d="M37 30v6M10 18v.01M32 28v.01"/>` },
  return: { box: 48, body: `<path ${soft} d="M10 18 24 11l14 7v16l-14 7-14-7Z"/><path ${ln} d="M10 18 24 11l14 7v16l-14 7-14-7V18Zm0 0 14 7 14-7M24 25v16"/><path ${ln} d="M6 10a9 9 0 0 1 14-3M6 10V4m0 6h6"/>` },
  tape: { box: 48, body: `<circle ${soft} cx="19" cy="22" r="13"/><circle ${ln} cx="19" cy="22" r="13"/><circle ${ln} cx="19" cy="22" r="4"/><path ${ln} d="M32 22h12v8H19M24 30v-3M29 30v-4M34 30v-3M39 30v-4"/>` },
  tag: { box: 48, body: `<path ${soft} d="M6 24 24 6h16v16L22 40Z"/><path ${ln} d="M6 24 24 6h16v16L22 40 6 24Z"/><circle ${ln} cx="33" cy="13" r="2.5"/><path ${ln} d="m17 29 8-8M17 22h.01M25 29h.01"/>` },
  sparkle: { box: 24, body: `<path fill="currentColor" d="M12 0c.6 5.6 2.6 10.4 12 12-9.4 1.6-11.4 6.4-12 12-.6-5.6-2.6-10.4-12-12 9.4-1.6 11.4-6.4 12-12Z"/>` },
  arrow: { box: 24, body: `<path ${ln} d="M19 12H5m6-6-6 6 6 6"/>` },
  bag: { box: 24, body: `<path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M5.5 8.5h13l-1 12h-11z"/><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/>` },
  whatsapp: { box: 24, body: `<path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.4.1-.6.3-.2.2-.8.8-.8 2s.8 2.3 1 2.5c.1.2 1.6 2.5 4 3.5 1.5.6 2 .7 2.8.6.4-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.1-1.2l-.4-.2Z"/>` },
};
const a = art[name];
---

<svg class={["icon", cls].filter(Boolean).join(" ")} viewBox={`0 0 ${a.box} ${a.box}`} width={size} height={size} aria-hidden="true" set:html={a.body} />
