---
import { breadcrumbJsonLd, productJsonLd, serializeJsonLd } from "@platform/seo";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { beltsUrl, coverOf, imageOf, price, productName, productsOfStyle, styleText, styles } from "../store.ts";
import type { CatalogProduct } from "@platform/commerce";
import OfferStrip from "./OfferStrip.astro";
import ProductCard from "./ProductCard.astro";
import Icon from "./ui/Icon.astro";
import { langPath, site } from "../site.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang; product: CatalogProduct }
const { lang, product } = Astro.props;
const ar = lang === "ar";
const name = productName(lang, product);
const st = styleText(lang, product.style);
const cur = ar ? "جنيه" : "EGP";
const siblings = productsOfStyle(product.style);
const related = styles.filter((x) => x.id !== product.style).slice(0, 4).map((x) => coverOf(x.id));
const info = ar
  ? [
      ["الخامة", "جلد PU. أما الجلد الطبيعي فيتوفر فقط عند الطلب الخاص."],
      ["المقاس", `المقاس المعتاد بعرض 14 سم وطول 140 سم، ويناسب حتى ${site.maxWeightKg} كجم. نفصّل مقاسًا خاصًا عند الطلب.`],
      ["الصنعة", "قصّ بالليزر وخياطة وتشطيب يدويان، ويراجع مؤسس فيكونا كل حزام قبل الشحن."],
      ["التوصيل والاسترجاع", `توصيل خلال ${site.deliveryDays} أيام عمل إلى جميع المحافظات، واسترجاع خلال ${site.returnDays} يومًا. الدفع عند الاستلام أو InstaPay.`],
    ]
  : [
      ["Material", "PU leather. Natural leather is only available as a custom order."],
      ["Size", `The usual size is 14 cm wide and 140 cm long and fits up to ${site.maxWeightKg} kg. We make a custom size on request.`],
      ["Craft", "Laser-cut, then sewn and finished by hand. The founder checks every belt before it ships."],
      ["Delivery and returns", `Delivery in ${site.deliveryDays} working days to every governorate, ${site.returnDays}-day returns. Cash on delivery or InstaPay.`],
    ];
const title = ar ? `${name} | حزام خصر نسائي | فيكونا` : `${name} | Women's waist belt | Vicuna`;
const description = ar
  ? `${name} من فيكونا بسعر ${price(product.style)} جنيه. توصيل لكل مصر خلال ${site.deliveryDays} أيام عمل واسترجاع خلال ${site.returnDays} يوم.`
  : `${name} by Vicuna at ${price(product.style)} EGP. Delivery across Egypt in ${site.deliveryDays} working days, ${site.returnDays}-day returns.`;
const url = `${site.url}${beltsUrl(lang, product.id)}`;
const crumbs = [
  { name: ar ? "الرئيسية" : "Home", href: langPath(lang, "/") },
  { name: ar ? "الأحزمة" : "Belts", href: beltsUrl(lang) },
  { name: st.name, href: beltsUrl(lang, product.style) },
  { name: name },
];
const jsonLd = serializeJsonLd([
  productJsonLd({
    name,
    description: st.intro,
    url,
    images: [`${site.url}${imageOf(product)}`],
    sku: product.id,
    brand: "Vicuna",
    price: Number(price(product.style)),
    currency: "EGP",
    inStock: true,
  }),
  breadcrumbJsonLd([
    { name: crumbs[0]!.name, url: `${site.url}${crumbs[0]!.href}` },
    { name: crumbs[1]!.name, url: `${site.url}${crumbs[1]!.href}` },
    { name: crumbs[2]!.name, url: `${site.url}${crumbs[2]!.href}` },
    { name, url },
  ]),
]);
const orderText = ar
  ? `أهلاً فيكونا، عايزة أطلب: ${name} (${product.id})`
  : `Hello Vicuna, I would like to order: ${name} (${product.id})`;
const wa = `https://wa.me/${site.whatsappInternational}?text=${encodeURIComponent(orderText)}`;
---

<Base title={title} description={description} lang={lang} altPath={beltsUrl(ar ? "en" : "ar", product.id)} jsonLd={jsonLd} image={imageOf(product)}>
  <Breadcrumbs items={crumbs} />
  <div class="wrap product">
    <figure class="pdp-photo" style={`--tint:${product.hex}`}>
      <img src={imageOf(product)} alt={name} width="900" height="900" fetchpriority="high" />
    </figure>
    <div class="pdp-info">
      <a class="tag" href={beltsUrl(lang, product.style)}>{st.name}</a>
      <h1>{name}</h1>
      <div class="price">{price(product.style)} <small>{cur}</small></div>
      <p class="soldout" data-soldout-for={product.id} hidden>{ar ? "نفدت الكمية حاليًا. كلمينا على واتساب نبلغك أول ما يتوفر." : "Sold out for now. Message us on WhatsApp and we will tell you when it is back."}</p>
      <p class="muted">{st.intro}</p>
      <p class="swatch-label">{ar ? "اللون:" : "Colour:"} <b>{productName(lang, product)}</b></p>
      <div class="pdp-swatches" aria-label={ar ? "ألوان متاحة" : "Available colours"}>
        {siblings.map((sib) => (
          <a class="swatch big" href={beltsUrl(lang, sib.id)} style={`--c:${sib.hex}`} title={productName(lang, sib)} aria-label={productName(lang, sib)} aria-current={sib.id === product.id ? "true" : undefined}></a>
        ))}
      </div>
      <div class="pdp-actions">
        <button type="button" class="btn btn-berry btn-block" data-add={product.id}><Icon name="bag" size={20} /> {ar ? "أضيفي للسلة" : "Add to cart"}</button>
        <a class="btn btn-white btn-block" href={wa} rel="noopener noreferrer"><Icon name="whatsapp" size={18} /> {ar ? "أو اطلبي على واتساب" : "Or order on WhatsApp"}</a>
      </div>
      <ul class="pdp-perks">
        <li><Icon name="plane" size={26} /> {ar ? `توصيل لكل مصر خلال ${site.deliveryDays} أيام عمل` : `Delivery across Egypt in ${site.deliveryDays} working days`}</li>
        <li><Icon name="return" size={26} /> {ar ? `استرجاع خلال ${site.returnDays} يومًا دون مصاريف شحن` : `${site.returnDays}-day returns, no shipping cost to you`}</li>
        <li><Icon name="cash" size={26} /> {ar ? "الدفع عند الاستلام أو InstaPay" : "Cash on delivery or InstaPay"}</li>
      </ul>
      <OfferStrip lang={lang} />
    </div>
  </div>
  <section class="wrap">
    <div class="spec-card reveal">
      <h2>{ar ? "التفاصيل" : "Details"}</h2>
      <dl class="spec-table">
        {info.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
      </dl>
    </div>
  </section>
  <section class="wrap style-group">
    <div class="group-head"><h2>{ar ? "قد يعجبك أيضًا" : "You may also like"} <Icon name="sparkle" size={16} class="twinkle" /></h2></div>
    <div class="grid">
      {related.map((p, i) => <ProductCard product={p} lang={lang} index={i} />)}
    </div>
  </section>
</Base>
