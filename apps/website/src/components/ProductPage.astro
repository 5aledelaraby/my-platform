---
import { breadcrumbJsonLd, productJsonLd, serializeJsonLd } from "@platform/seo";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import { beltsUrl, coverOf, imageOf, srcsetOf, priceOfProduct, productName, productsOfStyle, shadeName, styleText, styles } from "../store.ts";
import { PIASTERS_PER_EGP, SHIPPING, priceOf } from "@platform/commerce";
import type { CatalogProduct } from "@platform/commerce";
import ProductCard from "./ProductCard.astro";
import Icon from "./ui/Icon.astro";
import Sparkles from "./ui/Sparkles.astro";
import { langPath, site } from "../site.ts";
import { looksOf } from "../lib/looks.ts";
import { designOf } from "../lib/designs.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang; product: CatalogProduct }
const { lang, product } = Astro.props;
const ar = lang === "ar";
const name = productName(lang, product);
const st = styleText(lang, product.style);
const cur = ar ? "جنيه" : "EGP";
const siblings = productsOfStyle(product.style);
// Neighbouring colours of the same design, for swipe and the arrows on the photo (wraps around).
const idx = siblings.findIndex((s) => s.id === product.id);
const nextP = siblings.length > 1 ? siblings[(idx + 1) % siblings.length]! : null;
const prevP = siblings.length > 1 ? siblings[(idx - 1 + siblings.length) % siblings.length]! : null;
const looks = looksOf(product);
// A close-up under the on-model photos: the croc print on croc belts, the lace and its satin bow on lace belts
// (owner, 2026-10-16).
const detailOf = (p: CatalogProduct): { src: string; alt: string } | null =>
  p.id.includes("-croc-")
    ? { src: "/img/editorial/croc-detail", alt: ar ? "نقشة الكروكو عن قرب" : "The croc print, up close" }
    : p.style === "lace"
      ? { src: "/img/editorial/lace-bow", alt: ar ? "الدانتيل وفيونكة الساتان عن قرب" : "The lace and its satin bow, up close" }
      : null;
const detail = detailOf(product);
const related = styles.filter((x) => x.id !== product.style).slice(0, 4).map((x) => coverOf(x.id));
// Size: what the owner gave for this design (lib/designs.ts), else the usual size.
const specs = designOf(product.style).specs[lang];
const info = ar
  ? [
      ["الخامة", "جلد PU. أما الجلد الطبيعي فيتوفر فقط عند الطلب الخاص."],
      ["المقاس", specs.length ? `${specs.join("، ")}. نفصّل مقاسًا خاصًا عند الطلب.` : `المقاس المعتاد بعرض 14 سم وطول 140 سم، ويناسب حتى ${site.maxWeightKg} كجم. نفصّل مقاسًا خاصًا عند الطلب.`],
      ["الصنعة", "قصّ بالليزر وخياطة يدوية."],
      ["التوصيل والاسترجاع", `توصيل خلال ${site.deliveryDays} أيام عمل إلى جميع المحافظات، واسترجاع خلال ${site.returnDays} يومًا. الدفع عند الاستلام أو بالكارت.`],
    ]
  : [
      ["Material", "PU leather. Natural leather is only available as a custom order."],
      ["Size", specs.length ? `${specs.join(", ")}. We make a custom size on request.` : `The usual size is 14 cm wide and 140 cm long and fits up to ${site.maxWeightKg} kg. We make a custom size on request.`],
      ["Craft", "Laser-cut and sewn by hand."],
      ["Delivery and returns", `Delivery in ${site.deliveryDays} working days to every governorate, ${site.returnDays}-day returns. Cash on delivery or card.`],
    ];
// "Wear it with": the outfits the owner suggests for every belt (owner, 2026-10-16).
const wearWith: [string, string][] = ar
  ? [["💼", "لبس الشغل"], ["👖", "الجينز والكاجوال"], ["🧥", "الجاكيت والبالطو"], ["🎓", "أيام الجامعة"], ["👗", "الفساتين السواريه والمناسبات"]]
  : [["💼", "Workwear"], ["👖", "Jeans & casual"], ["🧥", "Jackets & coats"], ["🎓", "Uni days"], ["👗", "Evening dresses & occasions"]];
const title = ar ? `${name} | حزام خصر نسائي | فيكونا` : `${name} | Women's waist belt | Vicuna`;
const description = ar
  ? `${name} من فيكونا بسعر ${priceOfProduct(product)} جنيه. توصيل لكل مصر خلال ${site.deliveryDays} أيام عمل واسترجاع خلال ${site.returnDays} يوم.`
  : `${name} by Vicuna at ${priceOfProduct(product)} EGP. Delivery across Egypt in ${site.deliveryDays} working days, ${site.returnDays}-day returns.`;
const url = `${site.url}${beltsUrl(lang, product.id)}`;
const crumbs = [
  { name: ar ? "الرئيسية" : "Home", href: langPath(lang, "/") },
  { name: ar ? "أحزمة الخصر" : "Waist belts", href: beltsUrl(lang) },
  { name: st.name, href: beltsUrl(lang, product.style) },
  { name: name },
];
const jsonLd = serializeJsonLd([
  productJsonLd({
    name,
    description: st.intro,
    url,
    images: [`${site.url}${imageOf(product)}`],
    sku: product.id,
    brand: "Vicuna",
    price: Number(priceOfProduct(product)),
    currency: "EGP",
    // Built as in stock; the site Worker switches it to OutOfStock when the live stock is zero (ADR 0013).
    inStock: true,
    shipping: [
      { rate: SHIPPING.standard / PIASTERS_PER_EGP, country: "EG" },
      { rate: SHIPPING.express / PIASTERS_PER_EGP, country: "EG" },
    ],
    returnPolicy: { country: "EG", days: site.returnDays, freeReturn: true },
  }),
  breadcrumbJsonLd([
    { name: crumbs[0]!.name, url: `${site.url}${crumbs[0]!.href}` },
    { name: crumbs[1]!.name, url: `${site.url}${crumbs[1]!.href}` },
    { name: crumbs[2]!.name, url: `${site.url}${crumbs[2]!.href}` },
    { name, url },
  ]),
]);
const waFor = (p: CatalogProduct) => {
  const n = productName(lang, p);
  const text = ar ? `أهلاً فيكونا، عايزة أطلب: ${n} (${p.id})` : `Hello Vicuna, I would like to order: ${n} (${p.id})`;
  return `https://wa.me/${site.whatsappInternational}?text=${encodeURIComponent(text)}`;
};
// Every colour of this design, so the page can change colour in place (no page load); the URL still changes.
const colourData = siblings.map((p) => {
  const n = productName(lang, p);
  return {
    id: p.id,
    url: beltsUrl(lang, p.id),
    alt: beltsUrl(ar ? "en" : "ar", p.id),
    name: n,
    shade: shadeName(lang, p),
    price: priceOfProduct(p),
    priceRaw: priceOf(p),
    image: imageOf(p),
    hex: p.hex,
    srcset: srcsetOf(p),
    title: ar ? `${n} | حزام خصر نسائي | فيكونا` : `${n} | Women's waist belt | Vicuna`,
    wa: waFor(p),
    looks: looksOf(p),
    lookAlt: ar ? `${n} على الخصر` : `${n}, worn at the waist`,
    detail: detailOf(p),
  };
});
const colourJson = JSON.stringify(colourData).replace(/</g, "\\u003c");
const orderText = ar
  ? `أهلاً فيكونا، عايزة أطلب: ${name} (${product.id})`
  : `Hello Vicuna, I would like to order: ${name} (${product.id})`;
const wa = `https://wa.me/${site.whatsappInternational}?text=${encodeURIComponent(orderText)}`;
---

<Base title={title} description={description} lang={lang} altPath={beltsUrl(ar ? "en" : "ar", product.id)} jsonLd={jsonLd} image={imageOf(product)}>
  <Breadcrumbs items={crumbs} />
  <div class="wrap product">
    <div class="pdp-media">
    <figure class="pdp-photo glow" style={`--tint:${product.hex}`} data-swipe-next={nextP ? beltsUrl(lang, nextP.id) : undefined} data-swipe-prev={prevP ? beltsUrl(lang, prevP.id) : undefined}>
      <Sparkles />
      <img data-pdp-img src={imageOf(product)} srcset={srcsetOf(product)} sizes="(min-width: 900px) 52vw, 100vw" alt={name} width="1200" height="1200" fetchpriority="high" />
      {nextP && prevP && (
        <>
          <a class="pdp-arrow prev" href={beltsUrl(lang, prevP.id)} aria-label={`${ar ? "اللون السابق" : "Previous colour"}: ${productName(lang, prevP)}`}><Icon name="arrow" size={18} /></a>
          <a class="pdp-arrow next" href={beltsUrl(lang, nextP.id)} aria-label={`${ar ? "اللون التالي" : "Next colour"}: ${productName(lang, nextP)}`}><Icon name="arrow" size={18} /></a>
          <span class="pdp-count" dir="ltr">{idx + 1} / {siblings.length}</span>
        </>
      )}
    </figure>
    {nextP && <link rel="prefetch" href={beltsUrl(lang, nextP.id)} />}
    {prevP && prevP !== nextP && <link rel="prefetch" href={beltsUrl(lang, prevP.id)} />}
    </div>
    <div class="pdp-info" data-view-item={product.id} data-view-name={name} data-view-price={priceOf(product)}>
      <a class="tag" href={beltsUrl(lang, product.style)}>{st.name}</a>
      <div class="pdp-title-row">
        <h1 data-pdp-name>{name}</h1>
        <button type="button" class="fav-btn pdp-fav" data-fav={product.id} data-fav-name={name} aria-pressed="false" aria-label={ar ? `إضافة ${name} للمفضلة` : `Add ${name} to favourites`}><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M12 20.3s-7.3-4.4-9.2-8.9C1.5 8.3 3.4 4.8 6.9 4.8c2 0 3.5 1.1 5.1 2.9 1.6-1.8 3.1-2.9 5.1-2.9 3.5 0 5.4 3.5 4.1 6.6-1.9 4.5-9.2 8.9-9.2 8.9z" /></svg></button>
      </div>
      <div class="price"><span data-pdp-price>{priceOfProduct(product)}</span> <small>{cur}</small></div>
      <p class="soldout" data-soldout-for={product.id} hidden>{ar ? "نفدت الكمية حاليًا. كلمينا على واتساب نبلغك أول ما يتوفر." : "Sold out for now. Message us on WhatsApp and we will tell you when it is back."}</p>
      <p class="swatch-label">{ar ? "اللون:" : "Colour:"} <b data-pdp-shade>{shadeName(lang, product)}</b></p>
      <div class="pdp-swatches" aria-label={ar ? "ألوان متاحة" : "Available colours"}>
        {siblings.map((sib) => (
          <a class="swatch big" href={beltsUrl(lang, sib.id)} style={`--c:${sib.hex}`} title={productName(lang, sib)} aria-label={productName(lang, sib)} aria-current={sib.id === product.id ? "true" : undefined}></a>
        ))}
      </div>
      <div class="pdp-actions">
        <button type="button" class="btn btn-berry btn-block bag-cta" data-add={product.id}>{ar ? "أضيفي للسلة 🛍️" : "Add to bag 🛍️"}</button>
        <a class="btn btn-white btn-block" data-pdp-wa href={wa} rel="noopener noreferrer"><Icon name="whatsapp" size={18} /> {ar ? "أو اطلبي على واتساب" : "Or order on WhatsApp"}</a>
      </div>
      <ul class="pdp-perks">
        <li><Icon name="plane" size={26} /> {ar ? `توصيل لكل مصر خلال ${site.deliveryDays} أيام عمل` : `Delivery across Egypt in ${site.deliveryDays} working days`}</li>
        <li><Icon name="return" size={26} /> {ar ? `استرجاع خلال ${site.returnDays} يومًا دون مصاريف شحن` : `${site.returnDays}-day returns, no shipping cost to you`}</li>
        <li><Icon name="cash" size={26} /> {ar ? "الدفع عند الاستلام أو بالكارت" : "Cash on delivery or card"}</li>
      </ul>
      <p class="pdp-intro muted">{st.intro}</p>
      <div class="wear-with reveal">
        <h2 class="wear-title">{ar ? "البسيه مع" : "Wear it with"}</h2>
        <ul class="wear-chips">
          {wearWith.map(([icon, label], i) => <li style={`--i:${i}`}><span class="wear-icon" aria-hidden="true">{icon}</span>{label}</li>)}
        </ul>
      </div>
    </div>
    <div class="pdp-looks" data-pdp-looks hidden={looks.length === 0 && !detail}>
        {looks.map((look) => (
          <figure class="pdp-look reveal">
            <img src={look.src} srcset={look.srcset} sizes="(min-width: 900px) 52vw, 100vw" alt={ar ? `${name} على الخصر` : `${name}, worn at the waist`} width="640" height="800" loading="lazy" decoding="async" />
          </figure>
        ))}
        {detail && (
          <figure class="pdp-look pdp-detail reveal">
            <img src={`${detail.src}-1200.webp`} srcset={`${detail.src}-640.webp 640w, ${detail.src}-1200.webp 1200w`} sizes="(min-width: 900px) 52vw, 100vw" alt={detail.alt} width="1200" height="1200" loading="lazy" decoding="async" />
          </figure>
        )}
    </div>
  </div>
  <section class="wrap">
    <div class="spec-card reveal">
      <h2>{ar ? "التفاصيل" : "Details"}</h2>
      <dl class="spec-table">
        {info.map(([t, d]) => <div><dt>{t}</dt><dd>{d}</dd></div>)}
      </dl>
    </div>
  </section>
  <section class="wrap style-group">
    <div class="group-head"><h2>{ar ? "قد يعجبك أيضًا" : "You may also like"}</h2></div>
    <div class="grid">
      {related.map((p, i) => <ProductCard product={p} lang={lang} index={i} />)}
    </div>
  </section>
  <script type="application/json" id="pdp-colours" set:html={colourJson} />
</Base>

<script>
  import { track } from "../scripts/tracking.ts";
  const el = document.querySelector<HTMLElement>("[data-view-item]");
  if (el) track({ type: "view_item", item: { id: el.dataset["viewItem"] ?? "", name: el.dataset["viewName"], price: Number(el.dataset["viewPrice"]) } });
</script>

<script>
  // Changing colour stays on the page: the arrows, the swatches and a swipe on the photo swap the photo, name,
  // price, buttons and on-model photos in place, and the address bar moves to that colour's own page (which also
  // works on its own, for sharing and search engines). Colours removed by the site Worker or hidden by the cart
  // (sold out) are skipped. Without this script every link still opens the colour's page as before.
  import { track } from "../scripts/tracking.ts";

  interface Look { src: string; srcset: string }
  interface Colour {
    id: string; url: string; alt: string; name: string; shade: string; price: string; priceRaw: number;
    image: string; hex: string; srcset: string; title: string; wa: string; looks: Look[]; lookAlt: string; detail: { src: string; alt: string } | null;
  }

  const raw = document.getElementById("pdp-colours")?.textContent;
  const fig = document.querySelector<HTMLElement>(".pdp-photo");
  const info = document.querySelector<HTMLElement>("[data-view-item]");
  if (raw && fig && info) {
    const colours: Colour[] = JSON.parse(raw);
    const byId = new Map(colours.map((c) => [c.id, c]));
    const rtl = document.documentElement.dir === "rtl";
    const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const ar = document.documentElement.lang !== "en";
    const q = <T extends Element>(sel: string) => document.querySelector<T>(sel);
    const swatches = () => [...document.querySelectorAll<HTMLAnchorElement>(".pdp-swatches a.swatch")];
    const idOf = (href: string) => new URL(href, location.href).pathname.replace(/\/$/, "").split("/").pop() ?? "";
    // The colours still on offer, in catalogue order: the swatches the Worker and the cart left visible.
    const available = () => swatches().filter((a) => !a.hidden).map((a) => byId.get(idOf(a.href))).filter((c): c is Colour => !!c);
    let current = info.dataset["viewItem"] ?? "";

    const escape = (s: string) => s.replace(/[&<>"]/g, (ch) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[ch]!);
    const renderLooks = (c: Colour) => {
      const box = q<HTMLElement>("[data-pdp-looks]");
      if (!box) return;
      const figs = c.looks.map((l) => `<figure class="pdp-look"><img src="${l.src}" srcset="${l.srcset}" sizes="(min-width: 900px) 52vw, 100vw" alt="${escape(c.lookAlt)}" width="640" height="800" loading="lazy" decoding="async"></figure>`);
      if (c.detail) figs.push(`<figure class="pdp-look pdp-detail"><img src="${c.detail.src}-1200.webp" srcset="${c.detail.src}-640.webp 640w, ${c.detail.src}-1200.webp 1200w" sizes="(min-width: 900px) 52vw, 100vw" alt="${escape(c.detail.alt)}" width="1200" height="1200" loading="lazy" decoding="async"></figure>`);
      box.innerHTML = figs.join("");
      box.hidden = figs.length === 0;
    };

    const show = async (id: string, dir: 1 | -1, push: boolean) => {
      const c = byId.get(id);
      if (!c || id === current) return;
      current = id;
      const list = available();
      const i = list.findIndex((x) => x.id === id);
      const next = list.length > 1 ? list[(i + 1) % list.length]! : null;
      const prev = list.length > 1 ? list[(i - 1 + list.length) % list.length]! : null;

      // Photo: load the new one first, then swap, so the old photo never blinks to empty.
      const img = q<HTMLImageElement>("[data-pdp-img]");
      if (img) {
        const pre = new Image();
        pre.sizes = img.sizes; pre.srcset = c.srcset; pre.src = c.image;
        await pre.decode().catch(() => undefined);
        if (current !== id) return; // another colour was picked meanwhile
        if (!calm) { fig.style.setProperty("--dir", String(dir * (rtl ? -1 : 1))); fig.classList.remove("swapping"); void fig.offsetWidth; fig.classList.add("swapping"); }
        img.srcset = c.srcset; img.src = c.image; img.alt = c.name;
        fig.style.setProperty("--tint", c.hex);
      }
      const set = (sel: string, text: string) => { const n = q<HTMLElement>(sel); if (n) n.textContent = text; };
      set("[data-pdp-name]", c.name);
      set("[data-pdp-price]", c.price);
      set("[data-pdp-shade]", c.shade);
      set(".crumbs [aria-current='page']", c.name);
      const wa = q<HTMLAnchorElement>("[data-pdp-wa]");
      if (wa) wa.href = c.wa;
      const fav = q<HTMLButtonElement>(".pdp-fav");
      if (fav) { fav.dataset["fav"] = c.id; fav.dataset["favName"] = c.name; dispatchEvent(new Event("vicuna:fav-refresh")); }
      const add = q<HTMLButtonElement>(".pdp-actions [data-add]");
      if (add) add.dataset["add"] = c.id;
      const out = q<HTMLElement>(".pdp-info [data-soldout-for]");
      if (out) { out.dataset["soldoutFor"] = c.id; out.hidden = true; }
      for (const a of swatches()) {
        if (idOf(a.href) === c.id) a.setAttribute("aria-current", "true");
        else a.removeAttribute("aria-current");
      }
      const arrow = (cls: string, to: Colour | null, label: string) => {
        const a = q<HTMLAnchorElement>(`.pdp-arrow.${cls}`);
        if (!a) return;
        a.hidden = !to;
        if (to) { a.href = to.url; a.setAttribute("aria-label", `${label}: ${to.name}`); }
      };
      arrow("next", next, ar ? "اللون التالي" : "Next colour");
      arrow("prev", prev, ar ? "اللون السابق" : "Previous colour");
      const count = q<HTMLElement>(".pdp-count");
      if (count) { count.textContent = `${i + 1} / ${list.length}`; count.hidden = list.length < 2; }
      renderLooks(c);
      info.dataset["viewItem"] = c.id; info.dataset["viewName"] = c.name; info.dataset["viewPrice"] = String(c.priceRaw);
      document.title = c.title;
      for (const l of document.querySelectorAll<HTMLAnchorElement>(".lang-switch, .menu-lang")) l.href = c.alt;
      if (push) history.pushState({ pdp: c.id }, "", c.url);
      track({ type: "view_item", item: { id: c.id, name: c.name, price: c.priceRaw } });
      // Warm the neighbours' photos so the next change is instant too.
      for (const n of [next, prev]) if (n) { const w = new Image(); w.sizes = img?.sizes ?? ""; w.srcset = n.srcset; w.src = n.image; }
    };
    const step = (n: 1 | -1) => {
      const list = available();
      const i = list.findIndex((x) => x.id === current);
      const to = list[(i + n + list.length) % list.length];
      if (to) void show(to.id, n, true);
    };

    history.replaceState({ pdp: current }, "");
    document.addEventListener("click", (e) => {
      const me = e as MouseEvent;
      if (me.button !== 0 || me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>(".pdp-arrow, .pdp-swatches a.swatch");
      if (!a) return;
      const id = idOf(a.href);
      if (!byId.has(id)) return;
      e.preventDefault();
      if (a.classList.contains("pdp-arrow")) step(a.classList.contains("next") ? 1 : -1);
      else {
        const list = available();
        void show(id, list.findIndex((x) => x.id === id) >= list.findIndex((x) => x.id === current) ? 1 : -1, true);
      }
    });
    addEventListener("popstate", (e) => {
      const id = (e.state as { pdp?: string } | null)?.pdp ?? idOf(location.href);
      if (byId.has(id)) void show(id, -1, false);
      else location.reload();
    });

    // Swipe the photo: against the reading direction = next colour. A gentle nudge on the first product page of a
    // visit shows that the photo can be swiped.
    let x0 = 0, y0 = 0, active = false;
    fig.addEventListener("touchstart", (e) => { const t = e.touches[0]!; x0 = t.clientX; y0 = t.clientY; active = true; }, { passive: true });
    fig.addEventListener("touchend", (e) => {
      if (!active) return;
      active = false;
      const t = e.changedTouches[0]!;
      const dx = t.clientX - x0, dy = t.clientY - y0;
      if (Math.abs(dx) < 50 || Math.abs(dx) < Math.abs(dy) * 1.5) return;
      step((rtl ? dx > 0 : dx < 0) ? 1 : -1);
    }, { passive: true });
    let seen = false;
    try { seen = sessionStorage.getItem("vicuna-swipe-hint") === "1"; sessionStorage.setItem("vicuna-swipe-hint", "1"); } catch { /* ignore */ }
    if (!calm && !seen && available().length > 1) setTimeout(() => fig.classList.add("nudge"), 700);
  }
</script>
