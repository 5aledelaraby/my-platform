---
// Cookie consent (Personal Data Protection Law 151/2020): analytics and ad tags load only after "Accept".
import { policyPath } from "../policies/index.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
---

<div class="consent" data-consent hidden role="dialog" aria-live="polite" aria-label={ar ? "الكوكيز" : "Cookies"}>
  <p>
    {ar ? "نستخدم الكوكيز للتحليل والإعلانات لتحسين تجربتكِ. " : "We use cookies for analytics and ads to improve your experience. "}
    <a href={policyPath(lang, "cookies")}>{ar ? "سياسة الكوكيز" : "Cookie policy"}</a>
  </p>
  <div class="consent-actions">
    <button type="button" class="btn btn-white" data-consent-choice="denied">{ar ? "رفض" : "Reject"}</button>
    <button type="button" class="btn" data-consent-choice="granted">{ar ? "موافقة" : "Accept"}</button>
  </div>
</div>

<script>
  import { consent, initTracking, setConsent } from "../scripts/tracking.ts";
  const box = document.querySelector<HTMLElement>("[data-consent]");
  if (box) {
    if (consent() === null) box.hidden = false;
    box.addEventListener("click", (event) => {
      const b = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-consent-choice]");
      if (!b) return;
      setConsent(b.dataset["consentChoice"] === "granted" ? "granted" : "denied");
      box.hidden = true;
    });
    document.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("[data-cookie-settings]")) {
        event.preventDefault();
        box.hidden = false;
      }
    });
  }
  initTracking();
</script>
