---
import { breadcrumbJsonLd, serializeJsonLd } from "@platform/seo";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import ProductCard from "./ProductCard.astro";
import Stories from "./Stories.astro";
import Icon from "./ui/Icon.astro";
import Sparkles from "./ui/Sparkles.astro";
import { beltsUrl, coverOf, imageOf, hasHigherPrices, price, priceOfProduct, productName, productsOfStyle, shadeName, srcsetOf, styleText } from "../store.ts";
import { langPath, site } from "../site.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang; styleId: string }
const { lang, styleId } = Astro.props;
const ar = lang === "ar";
const t = styleText(lang, styleId);
const list = productsOfStyle(styleId);
const cur = ar ? "جنيه" : "EGP";
const title = ar ? `${t.name} | أحزمة خصر نسائية | فيكونا` : `${t.name} waist belts | Vicuna`;
const from = hasHigherPrices(styleId);
// A film for the designs that have one (owner, 2026-10-16); the others keep the row of product photos.
const films: Record<string, string> = { "wide-tie": "/video/wide-tie-white", "thin-tie": "/video/thin-tie-camel" };
const film = films[styleId];
// Close-ups under the colours (owner, 2026-10-16): the croc print on the thin-tie page; on the lace page a photo of
// the lace and its satin bow next to a short film of the lace. Photos only, not products for sale.
type Detail = { kind: "img" | "film"; src: string; alt: string };
const detailsByStyle: Record<string, { caption: string; items: Detail[] }> = {
  "thin-tie": {
    caption: ar ? "نقشة الكروكو عن قرب" : "The croc print, up close",
    items: [{ kind: "img", src: "/img/editorial/croc-detail", alt: ar ? "حزام برباط رفيع بنقشة كروكو، صورة مقرّبة" : "A thin-tie belt in croc print, close up" }],
  },
  lace: {
    caption: ar ? "الدانتيل عن قرب" : "The lace, up close",
    items: [
      { kind: "img", src: "/img/editorial/lace-bow", alt: ar ? "دانتيل الحزام وفيونكة الساتان، صورة مقرّبة" : "The belt's lace and satin bow, close up" },
      { kind: "film", src: "/video/lace-detail", alt: "" },
    ],
  },
};
const details = detailsByStyle[styleId] ?? null;
const description = ar
  ? `${t.headline}. ${list.length} لون بسعر ${from ? "يبدأ من " : ""}${price(styleId)} جنيه. توصيل لكل مصر خلال ${site.deliveryDays} أيام.`
  : `${t.headline}. ${list.length} colours ${from ? "from" : "at"} ${price(styleId)} EGP. Delivery across Egypt in ${site.deliveryDays} days.`;
const crumbs = [
  { name: ar ? "الرئيسية" : "Home", href: langPath(lang, "/") },
  { name: ar ? "الأحزمة" : "Belts", href: beltsUrl(lang) },
  { name: t.name },
];
const jsonLd = serializeJsonLd(
  breadcrumbJsonLd([
    { name: crumbs[0]!.name, url: `${site.url}${crumbs[0]!.href}` },
    { name: crumbs[1]!.name, url: `${site.url}${crumbs[1]!.href}` },
    { name: t.name, url: `${site.url}${beltsUrl(lang, styleId)}` },
  ]),
);
---

<Base title={title} description={description} lang={lang} altPath={beltsUrl(ar ? "en" : "ar", styleId)} jsonLd={jsonLd} image={imageOf(coverOf(styleId))}>
  <section class="page-hero">
    <div class="page-hero-box style-hero">
      <div>
        <Breadcrumbs items={crumbs} />
        <h1 class="has-sparkles">{ar ? <>حزام <span class="accent">{t.name}</span></> : <><span class="accent">{t.name}</span> belts</>}<Sparkles variant="b" /></h1>
        <p class="hero-sub">{t.headline}</p>
        <p class="lead">{t.intro}</p>
        <div class="hero-actions">
          <span class="price-pill">{from && <small>{ar ? "من" : "from"}</small>} {price(styleId)} <small>{cur}</small></span>
          <a class="btn" href="#colours">{ar ? "شوفي الألوان" : "See the colours"} <Icon name="arrow" size={18} class="dir-icon" /></a>
        </div>
      </div>
      {film ? (
        <figure class="style-film">
          <video data-motion src={`${film}.mp4`} poster={`${film}.webp`} muted loop playsinline preload="metadata" aria-hidden="true" width="704" height="1280"></video>
        </figure>
      ) : (
        <div class="style-gallery" data-gallery aria-roledescription={ar ? "صور الألوان" : "colour photos"}>
          <div class="sg-track" data-track>
            {list.map((p, i) => (
              <article class="card sg-slide" data-color={p.color} data-product={p.id}>
                <a class="sg-media glow" href={beltsUrl(lang, p.id)} style={`--tint:${p.hex}`}>
                  <img src={imageOf(p)} srcset={srcsetOf(p)} sizes="(min-width: 960px) 40vw, 88vw" alt={productName(lang, p)} width="1200" height="1200" loading={i === 0 ? "eager" : "lazy"} decoding="async" />
                </a>
                <p class="sg-cap"><span>{shadeName(lang, p)}</span> <b>{priceOfProduct(p)} <small>{cur}</small></b></p>
              </article>
            ))}
          </div>
          <button type="button" class="sg-nav prev" data-step="-1" aria-label={ar ? "اللون السابق" : "Previous colour"} hidden><Icon name="arrow" size={20} /></button>
          <button type="button" class="sg-nav next" data-step="1" aria-label={ar ? "اللون التالي" : "Next colour"} hidden><Icon name="arrow" size={20} /></button>
          <div class="sg-dots" data-dots aria-hidden="true"></div>
        </div>
      )}
    </div>
  </section>

  <Stories lang={lang} current={styleId} />

  <section class="wrap style-group" id="colours">
    <div class="group-head">
      <h2>{ar ? `كل ألوان ${t.name}` : `Every ${t.name} colour`}</h2>
      <span class="count-chip">{list.length} {ar ? "لون" : "colours"}</span>
    </div>
    <div class="grid">
      {list.map((p, i) => <ProductCard product={p} lang={lang} index={i} />)}
    </div>
  </section>
  {details && (
    <section class="wrap style-group">
      <figure class={details.items.length > 1 ? "style-detail pair" : "style-detail"}>
        <div class="style-detail-media">
          {details.items.map((d) => <div class="sd-item">{d.kind === "img" ? (
            <img src={`${d.src}-1200.webp`} srcset={`${d.src}-640.webp 640w, ${d.src}-1200.webp 1200w`} sizes={details.items.length > 1 ? "(min-width: 760px) 40vw, 100vw" : "(min-width: 960px) 50vw, 100vw"} alt={d.alt} width="1200" height="1200" loading="lazy" decoding="async" />
          ) : (
            <video data-motion src={`${d.src}.mp4`} poster={`${d.src}.webp`} muted loop playsinline preload="none" aria-hidden="true" width="720" height="1264"></video>
          )}</div>)}
        </div>
        <figcaption>{details.caption}</figcaption>
      </figure>
    </section>
  )}
</Base>

<script>
  // The design's colours as one large photo: swipe sideways (native scrolling, snapping to each photo), or use the
  // arrows. Sold-out colours are removed by the site Worker or hidden by the cart and simply drop out.
  const gallery = document.querySelector<HTMLElement>("[data-gallery]");
  const track = gallery?.querySelector<HTMLElement>("[data-track]");
  if (gallery && track) {
    const slides = () => [...track.querySelectorAll<HTMLElement>(".sg-slide")].filter((s) => !s.hidden);
    const dots = gallery.querySelector<HTMLElement>("[data-dots]");
    let index = 0;
    const paint = () => {
      const list = slides();
      gallery.querySelectorAll<HTMLButtonElement>(".sg-nav").forEach((b) => (b.hidden = list.length < 2));
      if (dots) dots.innerHTML = list.length > 1 ? list.map((_, i) => `<span${i === index ? ' class="on"' : ""}></span>`).join("") : "";
    };
    const go = (i: number) => {
      const list = slides();
      if (!list.length) return;
      index = (i + list.length) % list.length;
      list[index]!.scrollIntoView({ inline: "center", block: "nearest", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      paint();
    };
    gallery.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".sg-nav");
      if (b) go(index + Number(b.dataset["step"]));
    });
    // Keep the dots in step with a finger swipe.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const i = slides().indexOf(e.target as HTMLElement);
        if (i >= 0 && i !== index) { index = i; paint(); }
      }
    }, { root: track, threshold: 0.6 });
    slides().forEach((s) => io.observe(s));
    paint();
  }
</script>
