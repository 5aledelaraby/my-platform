---
import { breadcrumbJsonLd, serializeJsonLd } from "@platform/seo";
import Base from "../layouts/Base.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import ProductCard from "./ProductCard.astro";
import Stories from "./Stories.astro";
import Icon from "./ui/Icon.astro";
import Sparkles from "./ui/Sparkles.astro";
import { beltsUrl, coverOf, imageOf, hasHigherPrices, price, priceOfProduct, productName, productsOfStyle, shadeName, srcsetOf, styleText } from "../store.ts";
import { langPath, site } from "../site.ts";
import type { Lang } from "../site.ts";
import { looksOf } from "../lib/looks.ts";

interface Props { lang: Lang; styleId: string }
const { lang, styleId } = Astro.props;
const ar = lang === "ar";
const t = styleText(lang, styleId);
const list = productsOfStyle(styleId);
const cur = ar ? "جنيه" : "EGP";
const title = ar ? `${t.name} | أحزمة خصر نسائية | فيكونا` : `${t.name} waist belts | Vicuna`;
const from = hasHigherPrices(styleId);
// Photos first (owner, 2026-10-16): every design page opens on one large photo that moves sideways — the on-model
// photos of its colours, then the design's film and close-ups — and only after it the grid of belts. Close-ups are
// photos only, not products for sale. A design with no photos yet falls back to its product photos.
type Extra = { kind: "img" | "film"; src: string; alt: string; caption: string; w?: number; h?: number };
const extrasByStyle: Record<string, Extra[]> = {
  "wide-tie": [{ kind: "film", src: "/video/wide-tie-white", alt: "", caption: ar ? "الأبيض في الحركة" : "White, in motion" }],
  "thin-tie": [
    { kind: "film", src: "/video/thin-tie-camel", alt: "", caption: ar ? "الكامل في الحركة" : "Camel, in motion" },
    { kind: "img", src: "/img/editorial/croc-detail", alt: ar ? "حزام وسط برباط رفيع بنقشة كروكو، صورة مقرّبة" : "A thin-tie waist belt in croc print, close up", caption: ar ? "نقشة الكروكو عن قرب" : "The croc print, up close", w: 1200, h: 1200 },
  ],
  lace: [
    { kind: "img", src: "/img/editorial/lace-ivory-1", alt: ar ? "حزام وسط دانتيل أبيض بفيونكة ساتان" : "A white lace waist belt with a satin bow", caption: ar ? "الدانتيل الأبيض" : "White lace", w: 1200, h: 1500 },
    { kind: "film", src: "/video/lace-detail", alt: "", caption: ar ? "الدانتيل عن قرب" : "The lace, up close" },
    { kind: "img", src: "/img/editorial/lace-bow", alt: ar ? "دانتيل الحزام وفيونكة الساتان، صورة مقرّبة" : "The belt's lace and satin bow, close up", caption: ar ? "فيونكة الساتان" : "The satin bow", w: 1200, h: 1200 },
    { kind: "img", src: "/img/editorial/lace-ivory-2", alt: ar ? "فيونكة ساتان على دانتيل أبيض" : "A satin bow on white lace", caption: ar ? "تفاصيل الدانتيل" : "Lace details", w: 1200, h: 1500 },
  ],
};
const lookSlides = list.flatMap((p) => looksOf(p).map((look) => ({ p, look })));
const extras = extrasByStyle[styleId] ?? [];
const hasPhotos = lookSlides.length + extras.length > 0;
const description = ar
  ? `${t.headline}. ${list.length} لون بسعر ${from ? "يبدأ من " : ""}${price(styleId)} جنيه. توصيل لكل مصر خلال ${site.deliveryDays} أيام.`
  : `${t.headline}. ${list.length} colours ${from ? "from" : "at"} ${price(styleId)} EGP. Delivery across Egypt in ${site.deliveryDays} days.`;
const crumbs = [
  { name: ar ? "الرئيسية" : "Home", href: langPath(lang, "/") },
  { name: ar ? "أحزمة الخصر" : "Waist belts", href: beltsUrl(lang) },
  { name: t.name },
];
const jsonLd = serializeJsonLd(
  breadcrumbJsonLd([
    { name: crumbs[0]!.name, url: `${site.url}${crumbs[0]!.href}` },
    { name: crumbs[1]!.name, url: `${site.url}${crumbs[1]!.href}` },
    { name: t.name, url: `${site.url}${beltsUrl(lang, styleId)}` },
  ]),
);
---

<Base title={title} description={description} lang={lang} altPath={beltsUrl(ar ? "en" : "ar", styleId)} jsonLd={jsonLd} image={imageOf(coverOf(styleId))}>
  <section class="style-top">
    <div class="style-stage style-gallery" data-gallery aria-roledescription={ar ? "صور التصميم" : "design photos"}>
      <div class="sg-track" data-track>
        {hasPhotos ? (
          <>
            {lookSlides.map(({ p, look }, i) => (
              <article class="card sg-slide sg-photo" data-color={p.color} data-product={p.id}>
                <a class="sg-shot" href={beltsUrl(lang, p.id)}>
                  <img src={look.src} srcset={look.srcset} sizes="(min-width: 960px) 46vw, 100vw" alt={ar ? `${productName(lang, p)} على الخصر` : `${productName(lang, p)}, worn at the waist`} width="640" height="800" loading={i === 0 ? "eager" : "lazy"} fetchpriority={i === 0 ? "high" : undefined} decoding="async" />
                  <span class="sg-over"><span>{shadeName(lang, p)}</span> <b>{priceOfProduct(p)} <small>{cur}</small></b></span>
                </a>
              </article>
            ))}
            {extras.map((x, i) => (
              <div class="sg-slide sg-photo">
                <figure class="sg-shot">
                  {x.kind === "film" ? (
                    <video data-motion src={`${x.src}.mp4`} poster={`${x.src}.webp`} muted loop playsinline preload="none" aria-hidden="true" width="704" height="1280"></video>
                  ) : (
                    <img src={`${x.src}-1200.webp`} srcset={`${x.src}-640.webp 640w, ${x.src}-1200.webp 1200w`} sizes="(min-width: 960px) 46vw, 100vw" alt={x.alt} width={x.w} height={x.h} loading={lookSlides.length === 0 && i === 0 ? "eager" : "lazy"} decoding="async" />
                  )}
                  <figcaption class="sg-over"><span>{x.caption}</span></figcaption>
                </figure>
              </div>
            ))}
          </>
        ) : list.map((p, i) => (
          <article class="card sg-slide" data-color={p.color} data-product={p.id}>
            <a class="sg-media glow" href={beltsUrl(lang, p.id)} style={`--tint:${p.hex}`}>
              <img src={imageOf(p)} srcset={srcsetOf(p)} sizes="(min-width: 960px) 46vw, 100vw" alt={productName(lang, p)} width="1200" height="1200" loading={i === 0 ? "eager" : "lazy"} decoding="async" />
            </a>
            <p class="sg-cap"><span>{shadeName(lang, p)}</span> <b>{priceOfProduct(p)} <small>{cur}</small></b></p>
          </article>
        ))}
      </div>
      <button type="button" class="sg-nav prev" data-step="-1" aria-label={ar ? "الصورة السابقة" : "Previous photo"} hidden><Icon name="arrow" size={20} /></button>
      <button type="button" class="sg-nav next" data-step="1" aria-label={ar ? "الصورة التالية" : "Next photo"} hidden><Icon name="arrow" size={20} /></button>
      <div class="sg-dots" data-dots aria-hidden="true"></div>
    </div>
    <div class="style-intro">
      <Breadcrumbs items={crumbs} />
      <h1 class="has-sparkles">{ar ? <>حزام وسط <span class="accent">{t.name}</span></> : <><span class="accent">{t.name}</span> waist belts</>}<Sparkles variant="b" /></h1>
      <p class="hero-sub">{t.headline}</p>
      <p class="lead">{t.intro}</p>
      <div class="hero-actions">
        <span class="price-pill">{from && <small>{ar ? "من" : "from"}</small>} {price(styleId)} <small>{cur}</small></span>
        <a class="btn" href="#colours">{ar ? "شوفي الألوان" : "See the colours"} <Icon name="arrow" size={18} class="dir-icon" /></a>
      </div>
    </div>
  </section>

  <Stories lang={lang} current={styleId} />

  <section class="wrap style-group" id="colours">
    <div class="group-head">
      <h2>{ar ? `كل ألوان ${t.name}` : `Every ${t.name} colour`}</h2>
      <span class="count-chip">{list.length} {ar ? "لون" : "colours"}</span>
    </div>
    <div class="grid">
      {list.map((p, i) => <ProductCard product={p} lang={lang} index={i} />)}
    </div>
  </section>
</Base>

<script>
  // The design's colours as one large photo: swipe sideways (native scrolling, snapping to each photo), or use the
  // arrows. Sold-out colours are removed by the site Worker or hidden by the cart and simply drop out.
  const gallery = document.querySelector<HTMLElement>("[data-gallery]");
  const track = gallery?.querySelector<HTMLElement>("[data-track]");
  if (gallery && track) {
    const slides = () => [...track.querySelectorAll<HTMLElement>(".sg-slide")].filter((s) => !s.hidden);
    const dots = gallery.querySelector<HTMLElement>("[data-dots]");
    let index = 0;
    const paint = () => {
      const list = slides();
      gallery.querySelectorAll<HTMLButtonElement>(".sg-nav").forEach((b) => (b.hidden = list.length < 2));
      if (dots) dots.innerHTML = list.length > 1 ? list.map((_, i) => `<span${i === index ? ' class="on"' : ""}></span>`).join("") : "";
    };
    const go = (i: number) => {
      const list = slides();
      if (!list.length) return;
      index = (i + list.length) % list.length;
      list[index]!.scrollIntoView({ inline: "center", block: "nearest", behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
      paint();
    };
    gallery.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>(".sg-nav");
      if (b) go(index + Number(b.dataset["step"]));
    });
    // Keep the dots in step with a finger swipe.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const i = slides().indexOf(e.target as HTMLElement);
        if (i >= 0 && i !== index) { index = i; paint(); }
      }
    }, { root: track, threshold: 0.6 });
    slides().forEach((s) => io.observe(s));
    paint();
  }
</script>
