---
// The belts collection (owner, 2026-10-16): black on white and few words. Each design is one large film (or, without
// one, an on-model photo) with its name, price and colours in small type under it, and a friendly link in.
// The colours of each design are swatch links (<a class="swatch">), which the site Worker removes when sold out.
import Icon from "./ui/Icon.astro";
import SpiralArrow from "./ui/SpiralArrow.astro";
import { homeCopy } from "../home-copy.ts";
import { articles, articleUrl } from "../lib/articles.ts";
import { leadOf } from "../lib/designs.ts";
import { JOURNAL_PATH, site } from "../site.ts";
import { beltsUrl, hasHigherPrices, price, productName, productsOfStyle, shadeName, styleText, styles } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeCopy[lang];
const ar = lang === "ar";
const cur = ar ? "جنيه" : "EGP";
const panels = styles.map((s, i) => ({ id: s.id, i, name: styleText(lang, s.id).name, lead: leadOf(s.id, lang), colours: productsOfStyle(s.id), from: hasHigherPrices(s.id) }));
const wa = `https://wa.me/${site.whatsappInternational}`;
const customWa = `${wa}?text=${encodeURIComponent(ar ? "أهلاً فيكونا، أرغب في حجز موعد لتفصيل حزام من الجلد الطبيعي على مقاسي." : "Hello Vicuna, I would like to book a made-to-measure natural leather belt.")}`;
// The title comes in word by word.
const words = (text: string, from: number) => text.split(" ").map((w, i) => ({ w, i: from + i }));
const line1 = words(ar ? "أحزمة خصر نسائية" : "Women's waist belts", 0);
const line2 = words(ar ? "اختاري تصميمك" : "Choose your design", line1.length);
---

<div class="wl">
  <section class="wl-intro wrap">
    <h1 class="wl-title">
      <span class="wl-small">{line1.map((x) => <span class="wl-word" style={`--w:${x.i}`}>{x.w} </span>)}</span>
      <span class="wl-big">{line2.map((x) => <span class="wl-word" style={`--w:${x.i}`}>{x.w} </span>)}</span>
    </h1>
    <p class="wl-lead wl-word" style={`--w:${line1.length + line2.length + 1}`}>{ar ? "جلد PU مستورد بضمان ضد التقشير ❤️" : "Imported PU leather, guaranteed not to peel ❤️"}</p>
    <nav class="wl-index wl-word" style={`--w:${line1.length + line2.length + 2}`} aria-label={ar ? "التصميمات" : "Designs"}>
      {panels.map((p) => <a href={beltsUrl(lang, p.id)} data-jump={`d-${p.id}`}>{p.name}</a>)}
    </nav>
  </section>

  <div class="wrap wl-grid">
    {panels.map((p) => (
      <article class="wl-panel reveal" id={`d-${p.id}`}>
        <figure class="wl-media">
          {p.lead.film ? (
            <video data-motion src={`${p.lead.film}.mp4`} poster={p.lead.img.src} muted loop playsinline preload={p.i === 0 ? "metadata" : "none"} aria-hidden="true" width={p.lead.img.w} height={p.lead.img.h}></video>
          ) : (
            <img src={p.lead.img.src} srcset={p.lead.img.srcset} sizes="(min-width: 900px) 46vw, 100vw" alt={p.lead.img.alt} width={p.lead.img.w} height={p.lead.img.h} loading={p.i === 0 ? "eager" : "lazy"} decoding="async" />
          )}
          <a class="wl-hit" href={beltsUrl(lang, p.id)} tabindex="-1" aria-hidden="true"></a>
        </figure>
        <div class="wl-text">
          <h2 class="wl-name"><a href={beltsUrl(lang, p.id)}>{p.name}</a></h2>
          <p class="wl-meta">
            <span class="wl-price">{p.from && <small>{ar ? "من" : "from"}</small>} {price(p.id)} <small>{cur}</small></span>
            <span class="wl-swatches" aria-label={ar ? "الألوان" : "Colours"}>
              {p.colours.map((x) => <a class="swatch" href={beltsUrl(lang, x.id)} style={`--c:${x.hex}`} aria-label={productName(lang, x)} title={shadeName(lang, x)}></a>)}
            </span>
          </p>
          <a class="wl-cta" href={beltsUrl(lang, p.id)}>{ar ? "تعالي اتفرجي عليه" : "Come take a look"} <SpiralArrow /></a>
        </div>
      </article>
    ))}
  </div>

  <section class="section">
    <div class="wrap">
      <div class="wl-bespoke reveal">
        <div>
          <h2 class="wl-h2">{c.customTitle}</h2>
          <a class="btn" href={customWa} rel="noopener noreferrer"><Icon name="whatsapp" size={18} /> {c.customCta}</a>
        </div>
        <img src="/img/leather-600.webp" srcset="/img/leather-600.webp 600w, /img/leather-1000.webp 1000w" sizes="(min-width: 960px) 40vw, 100vw" alt={ar ? "جلود طبيعية بألوان مختلفة معلّقة في الورشة" : "Natural leather hides in different colours hanging in the workshop"} width="600" height="450" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  {ar && articles.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="wl-h2">مقالات ونصائح</h2>
        <div class="wl-posts">
          {articles.slice(0, 3).map((a, i) => (
            <a class="wl-post reveal" href={articleUrl(a.slug)} style={`--i:${i}`}>
              <img src={a.image} alt={a.imageAlt} width={a.imageWidth} height={a.imageHeight} loading="lazy" decoding="async" />
              <b>{a.title}</b>
            </a>
          ))}
        </div>
        <p class="wl-more"><a class="textlink" href={JOURNAL_PATH}>كل المقالات</a></p>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap wl-faq">
      <h2 class="wl-h2">{c.faqTitle}</h2>
      {c.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </div>
  </section>
</div>

<script>
  // The design index scrolls to the design's panel on this page; the panel itself (or its link) opens the design.
  document.querySelectorAll<HTMLAnchorElement>("[data-jump]").forEach((a) => {
    a.addEventListener("click", (e) => {
      const target = document.getElementById(a.dataset["jump"] ?? "");
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    });
  });
</script>
