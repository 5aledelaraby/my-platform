---
// The belts collection (owner, 2026-10-16): a lookbook of the designs in the "signature pattern" style. Each design
// is one large panel led by its film (or, without one, an on-model photo); the visitor picks a design and goes in.
// The colours of each design are swatch links (<a class="swatch">), which the site Worker removes when sold out.
import Icon from "./ui/Icon.astro";
import Sparkles from "./ui/Sparkles.astro";
import { homeCopy } from "../home-copy.ts";
import { articles, articleUrl } from "../lib/articles.ts";
import { designOf } from "../lib/designs.ts";
import { looksOf } from "../lib/looks.ts";
import { JOURNAL_PATH, site } from "../site.ts";
import { beltsUrl, getProduct, hasHigherPrices, price, productName, productsOfStyle, shadeName, styleText, styles } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeCopy[lang];
const ar = lang === "ar";
const cur = ar ? "جنيه" : "EGP";
const pad = (n: number) => String(n).padStart(2, "0");
const panels = styles.map((s, i) => {
  const d = designOf(s.id);
  const look = d.lead.kind === "look" ? getProduct(d.lead.productId) : undefined;
  return {
    id: s.id,
    i,
    t: styleText(lang, s.id),
    word: d.word,
    film: d.lead.kind === "film" ? d.lead.src : undefined,
    photo: look ? { ...looksOf(look)[0]!, alt: ar ? `${productName(lang, look)} على الخصر` : `${productName(lang, look)}, worn at the waist` } : undefined,
    colours: productsOfStyle(s.id),
    from: hasHigherPrices(s.id),
  };
});
const wa = `https://wa.me/${site.whatsappInternational}`;
const customWa = `${wa}?text=${encodeURIComponent(ar ? "أهلاً فيكونا، أرغب في حجز موعد لتفصيل حزام من الجلد الطبيعي على مقاسي." : "Hello Vicuna, I would like to book a made-to-measure natural leather belt.")}`;
---

<div class="lux dx">
  <section class="dx-intro wrap">
    <p class="lux-kicker lux-in" lang="en" style="--d:0"><span class="lux-rule" aria-hidden="true"></span>VICUNA · WAIST BELTS</p>
    <h1 class="lux-title dx-title">
      <span class="lux-line"><span class="lux-in" style="--d:1">{ar ? "أحزمة خصر نسائية" : "Women's waist belts"}</span></span>
      <span class="lux-line"><span class="lux-in" style="--d:2">{ar ? "اختاري تصميمك" : "Choose your design"}</span></span>
    </h1>
    <p class="lux-lead lux-in" style="--d:3">{ar ? "من جلد PU، بخمسة تصميمات وألوان كثيرة، للفستان والبلوزة والجاكيت." : "In PU leather, in five designs and many colours, for dresses, blouses and jackets."}</p>
    <p class="lux-terms lux-in" style="--d:3">{ar ? `توصيل لكل مصر خلال ${site.deliveryDays} أيام عمل · استرجاع خلال ${site.returnDays} يومًا` : `Delivery across Egypt in ${site.deliveryDays} working days · ${site.returnDays}-day returns`}</p>
    <nav class="dx-index lux-in" style="--d:4" aria-label={ar ? "التصميمات" : "Designs"}>
      {panels.map((p) => <a href={beltsUrl(lang, p.id)} data-jump={`d-${p.id}`}><span dir="ltr">{pad(p.i + 1)}</span> {p.t.name}</a>)}
    </nav>
  </section>

  {panels.map((p) => (
    <article class="dx-panel" id={`d-${p.id}`}>
      <a class="dx-hit" href={beltsUrl(lang, p.id)} tabindex="-1" aria-hidden="true"></a>
      <figure class="dx-media">
        {p.film ? (
          <video data-motion src={`${p.film}.mp4`} poster={`${p.film}.webp`} muted loop playsinline preload={p.i === 0 ? "metadata" : "none"} aria-hidden="true" width="704" height="1280"></video>
        ) : p.photo ? (
          <img src={p.photo.src} srcset={p.photo.srcset} sizes="(min-width: 960px) 56vw, 100vw" alt={p.photo.alt} width="640" height="800" loading={p.i === 0 ? "eager" : "lazy"} decoding="async" />
        ) : null}
      </figure>
      <div class="dx-text reveal">
        <p class="dx-num" dir="ltr">{pad(p.i + 1)} / {pad(panels.length)}</p>
        <p class="lux-kicker" lang="en"><span class="lux-rule" aria-hidden="true"></span>{p.word}</p>
        <h2 class={`dx-name${p.i === 0 ? " has-sparkles" : ""}`}>
          <a class="dx-link" href={beltsUrl(lang, p.id)}>{ar ? <><small>حزام خصر</small> {p.t.name}</> : <>{p.t.name} <small class="dx-sub">waist belt</small></>}</a>
          {p.i === 0 && <Sparkles variant="b" />}
        </h2>
        <p class="dx-line">{p.t.intro}</p>
        <div class="dx-meta">
          <span class="dx-price">{p.from && <small>{ar ? "من" : "from"}</small>} {price(p.id)} <small>{cur}</small></span>
          <span class="dx-swatches" aria-label={ar ? "الألوان" : "Colours"}>
            {p.colours.map((x) => <a class="swatch" href={beltsUrl(lang, x.id)} style={`--c:${x.hex}`} aria-label={productName(lang, x)} title={shadeName(lang, x)}></a>)}
          </span>
        </div>
        <span class="btn lux-btn dx-cta" aria-hidden="true">{ar ? "ادخلي على التصميم" : "See the design"} <Icon name="arrow" size={18} class="dir-icon" /></span>
      </div>
    </article>
  ))}

  <section class="lux-section">
    <div class="wrap">
      <div class="dx-bespoke reveal">
        <div>
          <p class="lux-kicker" lang="en"><span class="lux-rule" aria-hidden="true"></span>MADE TO MEASURE</p>
          <h2 class="lux-h2">{c.customTitle}</h2>
          <p class="lux-lead">{c.customBody}</p>
          <a class="btn lux-btn" href={customWa} rel="noopener noreferrer"><Icon name="whatsapp" size={18} /> {c.customCta}</a>
        </div>
        <img src="/img/leather-600.webp" srcset="/img/leather-600.webp 600w, /img/leather-1000.webp 1000w" sizes="(min-width: 960px) 40vw, 100vw" alt={ar ? "جلود طبيعية بألوان مختلفة معلّقة في الورشة" : "Natural leather hides in different colours hanging in the workshop"} width="600" height="450" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  {ar && articles.length > 0 && (
    <section class="lux-section">
      <div class="wrap">
        <header class="lux-head reveal">
          <p class="lux-kicker" lang="en"><span class="lux-rule" aria-hidden="true"></span>THE JOURNAL</p>
          <h2 class="lux-h2">مقالات ونصائح</h2>
        </header>
        <div class="dx-posts">
          {articles.slice(0, 3).map((a, i) => (
            <a class="dx-post reveal" href={articleUrl(a.slug)} style={`--i:${i}`}>
              <img src={a.image} alt={a.imageAlt} width={a.imageWidth} height={a.imageHeight} loading="lazy" decoding="async" />
              <b>{a.title}</b>
            </a>
          ))}
        </div>
        <p class="dx-more"><a class="lux-more" href={JOURNAL_PATH}>كل المقالات</a></p>
      </div>
    </section>
  )}

  <section class="lux-section lux-close">
    <div class="wrap dx-faq">
      <header class="lux-head reveal">
        <p class="lux-kicker" lang="en"><span class="lux-rule" aria-hidden="true"></span>QUESTIONS</p>
        <h2 class="lux-h2">{c.faqTitle}</h2>
      </header>
      {c.faq.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
      <p class="lux-mark" lang="en" aria-hidden="true">VICUNA</p>
    </div>
  </section>
</div>

<script>
  // The design index scrolls to the design's panel on this page; the panel itself (or its link) opens the design.
  document.querySelectorAll<HTMLAnchorElement>("[data-jump]").forEach((a) => {
    a.addEventListener("click", (e) => {
      const target = document.getElementById(a.dataset["jump"] ?? "");
      if (!target) return;
      e.preventDefault();
      target.scrollIntoView({ behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth" });
    });
  });
</script>
