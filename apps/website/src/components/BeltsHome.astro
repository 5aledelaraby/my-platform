---
import Icon from "./ui/Icon.astro";
import ProductCard from "./ProductCard.astro";
import Stories from "./Stories.astro";
import { homeCopy } from "../home-copy.ts";
import { articles, articleUrl } from "../lib/articles.ts";
import { JOURNAL_PATH, site } from "../site.ts";
import { colorName, colors, products, styles } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = homeCopy[lang];
const ar = lang === "ar";
// One grid ordered by colour family (all the black belts together, then white, ...), then by style:
// the eye moves through one colour at a time instead of jumping between colours.
const colourRank = new Map(colors.map((cl, i) => [cl.id, i]));
const styleRank = new Map(styles.map((st, i) => [st.id, i]));
const byColour = [...products].sort((a, b) =>
  (colourRank.get(a.color) ?? 99) - (colourRank.get(b.color) ?? 99) || (styleRank.get(a.style) ?? 99) - (styleRank.get(b.style) ?? 99));
const wa = `https://wa.me/${site.whatsappInternational}`;
const customWa = `${wa}?text=${encodeURIComponent(ar ? "أهلاً فيكونا، أرغب في حجز موعد لتفصيل حزام من الجلد الطبيعي على مقاسي." : "Hello Vicuna, I would like to book a made-to-measure natural leather belt.")}`;
const tie = ar
  ? [["ضعي الحزام على الخصر", "الجزء العريض إلى الأمام"], ["لفّي الشريطين", "وأعيديهما إلى الأمام"], ["اربطي بطريقتك", "فيونكة أو عقدة"]]
  : [["Place it on your waist", "wide part in front"], ["Wrap the straps", "and bring them forward"], ["Tie it your way", "a bow or a knot"]];
---

<section class="bh-hero">
  <div class="bh-grid">
    <figure class="bh-media">
      <img class="bh-slide s1" src="/img/editorial/lace-ivory-1-1200.webp" srcset="/img/editorial/lace-ivory-1-640.webp 640w, /img/editorial/lace-ivory-1-1200.webp 1200w" sizes="(min-width: 900px) 50vw, 100vw" alt={ar ? "حزام دانتيل عاجي بشريط ساتان" : "An ivory lace belt with a satin tie"} width="1200" height="1500" fetchpriority="high" decoding="async" />
      <img class="bh-slide s2" src="/img/editorial/lace-ivory-2-1200.webp" srcset="/img/editorial/lace-ivory-2-640.webp 640w, /img/editorial/lace-ivory-2-1200.webp 1200w" sizes="(min-width: 900px) 50vw, 100vw" alt="" width="1200" height="1500" decoding="async" />
      <figcaption class="bh-caption" lang="en">Shine like a diamond</figcaption>
    </figure>
    <div class="bh-text">
      <p class="bh-kicker" lang="en">VICUNA · BELTS</p>
      <h1>{c.h1}</h1>
      <p class="lead">{c.lead}</p>
      <div class="hero-actions">
        <a class="btn" href="#all">{c.cta}</a>
        <a class="btn btn-white" href={wa} rel="noopener noreferrer"><Icon name="whatsapp" size={18} /> {c.ctaWhatsapp}</a>
      </div>
      <ul class="bh-facts">
        <li>{ar ? `توصيل لكل مصر خلال ${site.deliveryDays} أيام عمل` : `Delivery across Egypt in ${site.deliveryDays} working days`}</li>
        <li>{ar ? `استرجاع خلال ${site.returnDays} يومًا` : `Returns within ${site.returnDays} days`}</li>
      </ul>
    </div>
  </div>
</section>

<Stories lang={lang} current="all" />


<section class="section" id="all">
  <div class="wrap">
    <h2 class="sr-only">{c.stylesTitle}</h2>
    <div class="filter" data-filter data-unit={ar ? "حزام" : "belts"} hidden>
      <span class="filter-label">{ar ? "اللون:" : "Colour:"}</span>
      <div class="swatch-row">
        {colors.map((cl) => (
          <button type="button" class="dot" data-color={cl.id} aria-pressed="false" title={colorName(lang, cl.id)} aria-label={colorName(lang, cl.id)} style={`--c:${cl.hex}`}></button>
        ))}
      </div>
      <button type="button" class="pill" data-color="all">{ar ? "عرض الكل" : "Show all"}</button>
      <span id="filter-status" class="muted" aria-live="polite"></span>
    </div>
  </div>
  <div class="wrap style-group" data-group>
    <div class="grid" data-grid>
      {byColour.map((p, i) => <ProductCard product={p} lang={lang} index={i} />)}
    </div>
  </div>
  <div class="wrap style-group" id="tie">
    <div class="tie-card reveal">
      <h2>{ar ? "طريقة الربط" : "How to tie"}</h2>
      <ol class="tie-steps">
        {tie.map(([t, d], i) => <li><span class="tie-num" aria-hidden="true">{i + 1}</span><span><b>{t}</b> <span class="muted">{d}</span></span></li>)}
      </ol>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <h2 class="h2">{ar ? "طرق ارتدائه" : "How to wear it"}</h2>
      <p class="muted">{ar ? "مع الفستان الواسع أو فوق البليزر، الحزام يحدّد الخصر ويغيّر الإطلالة." : "Over a flowing dress or a blazer, the belt defines the waist and changes the look."}</p>
    </div>
    <div class="lookbook">
      <figure class="reveal"><img src="/img/editorial/model-walk-640.webp" srcset="/img/editorial/model-walk-640.webp 640w, /img/editorial/model-walk-1200.webp 1200w" sizes="(min-width: 900px) 30vw, 50vw" alt={ar ? "حزام عريض بربطة رفيعة فوق فستان عاجي" : "A wide belt with a thin tie over an ivory dress"} width="640" height="800" loading="lazy" decoding="async" /><figcaption>{ar ? "مع الفستان" : "With a dress"}</figcaption></figure>
      <figure class="reveal" style="--i:1"><img src="/img/editorial/model-blazer-640.webp" srcset="/img/editorial/model-blazer-640.webp 640w, /img/editorial/model-blazer-1200.webp 1200w" sizes="(min-width: 900px) 30vw, 50vw" alt={ar ? "حزام أسود فوق قميص أبيض تحت البليزر" : "A black belt over a white shirt under a blazer"} width="640" height="800" loading="lazy" decoding="async" /><figcaption>{ar ? "مع البليزر" : "With a blazer"}</figcaption></figure>
      <figure class="reveal lb-wide" style="--i:2"><img src="/img/editorial/model-seated-640.webp" srcset="/img/editorial/model-seated-640.webp 640w, /img/editorial/model-seated-1200.webp 1200w" sizes="(min-width: 900px) 30vw, 100vw" alt={ar ? "حزام عاجي على الخصر مع فستان طويل" : "An ivory belt at the waist of a long dress"} width="640" height="800" loading="lazy" decoding="async" /><figcaption>{ar ? "إطلالة هادئة" : "A quiet look"}</figcaption></figure>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">{c.whyEyebrow}</p>
      <h2 class="h2">{c.whyTitle}</h2>
    </div>
    <div class="cards3">
      {c.why.map((w, i) => (
        <div class="soft-card reveal" style={`--i:${i}`}>
          <span class="num-badge" aria-hidden="true">{i + 1}</span>
          <h3>{w.t}</h3>
          <p class="muted">{w.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap detail">
    <figure class="detail-media reveal">
      <video src="/video/bow-black.mp4" poster="/video/bow-black.webp" autoplay muted loop playsinline preload="none" aria-hidden="true" width="540" height="948"></video>
    </figure>
    <div class="reveal">
      <p class="eyebrow">{ar ? "التفاصيل" : "The details"}</p>
      <h2 class="h2">{ar ? "خياطة متقنة وحواف نظيفة" : "Careful stitching, clean edges"}</h2>
      <p class="muted lede">{ar ? "جلد PU طري يلتف على الخصر، بقصّ ليزر وخياطة على الحواف، وربطة تتحمل الشد. نراجع كل حزام قبل أن يصل إليكِ." : "Soft PU leather that wraps the waist, laser-cut and stitched along the edges, with a tie that holds. We check every belt before it reaches you."}</p>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap split">
    <div class="reveal">
      <p class="eyebrow">{c.craftEyebrow}</p>
      <h2 class="h2">{c.craftTitle}</h2>
      <p class="muted lede">{c.craftBody}</p>
      <div class="founder-note">
        <img src="/img/founder.jpg" alt="" width="56" height="56" loading="lazy" decoding="async" />
        <div><b>{c.founderName}</b><br /><span class="muted">{c.founderRole}</span></div>
      </div>
    </div>
    <div class="real-stack">
      <figure class="photo-card reveal">
        <img
          src="/img/founder-collage-800.webp"
          srcset="/img/founder-collage-800.webp 800w, /img/founder-collage-1400.webp 1400w"
          sizes="(min-width: 960px) 46vw, 100vw"
          alt={c.collageAlt}
          width="800"
          height="415"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="photo-card reveal" style="--i:1">
        <img src="/img/laser-800.webp" alt={ar ? "ماكينة القصّ بالليزر أثناء تجهيز قطع الأحزمة" : "The laser cutting machine preparing belt pieces"} width="800" height="450" loading="lazy" decoding="async" />
        <figcaption class="photo-badge">{ar ? "قصّ بالليزر لحواف نظيفة ومتساوية" : "Laser cutting for clean, even edges"}</figcaption>
      </figure>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="bespoke reveal">
      <div class="bespoke-text">
        <p class="eyebrow">{c.customEyebrow}</p>
        <h2 class="h2">{c.customTitle}</h2>
        <p class="lede">{c.customBody}</p>
        <a class="btn btn-gold" href={customWa} rel="noopener noreferrer"><Icon name="whatsapp" size={18} /> {c.customCta}</a>
      </div>
      <img
        src="/img/leather-600.webp"
        srcset="/img/leather-600.webp 600w, /img/leather-1000.webp 1000w"
        sizes="(min-width: 960px) 40vw, 100vw"
        alt={ar ? "جلود طبيعية بألوان مختلفة معلّقة في الورشة" : "Natural leather hides in different colours hanging in the workshop"}
        width="600"
        height="450"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</section>

{ar && articles.length > 0 && (
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2 class="h2">مقالات ونصائح</h2>
        <p class="muted">أفكار لاختيار حزام الخصر وربطه وتنسيقه.</p>
      </div>
      <div class="posts">
        {articles.slice(0, 3).map((a) => (
          <a class="post" href={articleUrl(a.slug)}>
            <img src={a.image} alt={a.imageAlt} width={a.imageWidth} height={a.imageHeight} loading="lazy" decoding="async" />
            <h3>{a.title}</h3>
            <p class="muted">{a.description}</p>
          </a>
        ))}
      </div>
      <p class="more"><a class="btn btn-white" href={JOURNAL_PATH}>كل المقالات</a></p>
    </div>
  </section>
)}

<section class="section">
  <div class="wrap faq">
    <h2 class="h2">{c.faqTitle}</h2>
    {c.faq.map((f, i) => <details class="reveal" style={`--i:${i % 3}`}><summary>{f.q}</summary><p class="muted">{f.a}</p></details>)}
  </div>
</section>

<script>
  const bar = document.querySelector<HTMLElement>("[data-filter]");
  if (bar) {
    bar.hidden = false;
    const cards = [...document.querySelectorAll<HTMLElement>(".card[data-color]")];
    const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
    const status = document.getElementById("filter-status");
    const unit = bar.dataset["unit"] ?? "";
    let active: string | null = null;
    bar.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("button[data-color]");
      if (!button) return;
      const picked = button.dataset["color"] ?? "all";
      active = picked === "all" || picked === active ? null : picked;
      bar.querySelectorAll<HTMLButtonElement>(".dot").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset["color"] === active)));
      let shown = 0;
      for (const card of cards) {
        const show = active === null || card.dataset["color"] === active;
        card.hidden = !show;
        if (show) shown += 1;
      }
      for (const group of groups) group.hidden = [...group.querySelectorAll<HTMLElement>(".card")].every((c) => c.hidden);
      if (status) status.textContent = active === null ? "" : `${shown} ${unit}`;
    });
  }
</script>
