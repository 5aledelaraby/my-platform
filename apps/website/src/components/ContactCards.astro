---
// "Contact our team" cards (WhatsApp open, call, email), shared by the contact page and the bottom of the home page.
import Icon from "./ui/Icon.astro";
import { site } from "../site.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang; compact?: boolean }
const { lang, compact = false } = Astro.props;
const ar = lang === "ar";
const wa = `https://wa.me/${site.whatsappInternational}?text=${encodeURIComponent(ar ? "أهلاً فيكونا" : "Hello Vicuna")}`;
const tel = `tel:+${site.whatsappInternational}`;
const hours = site.supportHours[lang];
---

<div class="contact-cards">
  <details class="contact-card" open>
    <summary><span class="cc-title"><Icon name="whatsapp" size={26} /> {ar ? "واتساب" : "WhatsApp"}</span></summary>
    <div class="cc-body">
      <p>{ar ? "تحدّثي مع فريقنا مباشرة عن أي منتج أو طلب." : "Chat with our team about any product or order."}</p>
      <p>{ar ? `متاحون ${hours}` : `Available ${hours}`}</p>
      <p><a class="cc-number" href={wa} rel="noopener noreferrer"><bdi dir="ltr">+{site.whatsappInternational}</bdi></a></p>
      <a class="btn btn-block" href={wa} rel="noopener noreferrer">{ar ? "ابدئي المحادثة" : "Start the chat"}</a>
    </div>
  </details>
  {!compact && (
    <>
    <details class="contact-card">
      <summary><span class="cc-title"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" d="M6.6 3.5 9.3 3l1.9 4.4-2.2 1.6a12 12 0 0 0 6 6l1.6-2.2 4.4 1.9-.5 2.7c-.2 1-1.1 1.7-2.1 1.6C10.6 18.4 5.6 13.4 5 6.6c-.1-1 .6-1.9 1.6-2.1Z" /></svg> {ar ? "اتصلي بنا" : "Call us"}</span></summary>
      <div class="cc-body">
        <p>{ar ? `على الرقم نفسه، ${hours}.` : `On the same number, ${hours}.`}</p>
        <p><a class="cc-number" href={tel}><bdi dir="ltr">+{site.whatsappInternational}</bdi></a></p>
        <a class="btn btn-block" href={tel}>{ar ? "اتصلي الآن" : "Call now"}</a>
      </div>
    </details>
    <details class="contact-card">
      <summary><span class="cc-title"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="m3.8 7 8.2 6 8.2-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg> {ar ? "البريد الإلكتروني" : "Email"}</span></summary>
      <div class="cc-body">
        <p>{ar ? "للاستفسارات العامة:" : "General questions:"} <a href={`mailto:${site.email}`}><bdi dir="ltr">{site.email}</bdi></a></p>
        <p>{ar ? "للطلبات والإرجاع والاستبدال:" : "Orders, returns and exchanges:"} <a href={`mailto:${site.supportEmail}`}><bdi dir="ltr">{site.supportEmail}</bdi></a></p>
      </div>
    </details>
    </>
  )}
</div>
