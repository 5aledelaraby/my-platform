---
// /about/: who Vicuna Designs is. Neutral theme (not a belts page); kept general so new activities fit in.
import Base from "../layouts/Base.astro";
import { langPath, site } from "../site.ts";
import { beltsUrl } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
const title = ar ? "من نحن | فيكونا ديزاينز" : "About us | Vicuna Designs";
const description = ar
  ? "فيكونا ديزاينز علامة مصرية مقرها القاهرة، تعمل في التصميم: من المنتجات المصنوعة يدويًا إلى تصميم المواقع الإلكترونية وبنائها."
  : "Vicuna Designs is an Egyptian brand based in Cairo working across design, from handmade products to designing and building websites.";
const work = ar
  ? [
      { t: "المنتجات والإكسسوارات", d: "نصمّم ونصنع بأيدينا. أول ما بدأنا به: أحزمة الخصر.", href: beltsUrl(lang) },
      { t: "تصميم المواقع وبناؤها", d: "نصمّم المواقع الإلكترونية ونبنيها: سريعة وواضحة وسهلة الاستخدام." },
    ]
  : [
      { t: "Products and accessories", d: "We design and make by hand. Where we started: waist belts.", href: beltsUrl(lang) },
      { t: "Website design and building", d: "We design and build websites: fast, clear and easy to use." },
    ];
---

<Base title={title} description={description} lang={lang} image="/img/founder-collage-1400.webp">
  <section class="wrap about-page">
    <header class="about-head">
      <p class="intro-kicker" lang="en">VICUNA DESIGNS</p>
      <h1>{ar ? "من نحن" : "About us"}</h1>
      <p class="lead">
        {ar
          ? "فيكونا ديزاينز علامة مصرية مقرها القاهرة، نعمل في التصميم بأشكاله المختلفة."
          : "Vicuna Designs is an Egyptian brand based in Cairo, working across design."}
      </p>
    </header>
    <figure class="about-photo about-founder"><img src="/img/founder-collage-1400.webp" srcset="/img/founder-collage-800.webp 800w, /img/founder-collage-1400.webp 1400w" sizes="(min-width: 900px) 820px, 100vw" alt="Khaled Elaraby, Vicuna's founder, fitting a blue waist belt on a dress form" width="1400" height="726" decoding="async" /></figure>
    <figure class="about-photo about-mannequin">
      <img src="/img/editorial/about-mannequin-1200.webp" srcset="/img/editorial/about-mannequin-640.webp 640w, /img/editorial/about-mannequin-1200.webp 1200w" sizes="(min-width: 900px) 820px, 100vw" alt="A blue Vicuna waist belt on a dress form" width="1200" height="1200" loading="lazy" decoding="async" />
      <figcaption class="script">The art of the waist</figcaption>
    </figure>
    <h2 class="about-h2">{ar ? "ماذا نفعل" : "What we do"}</h2>
    <ul class="about-work">
      {work.map((w) => (
        <li>
          <h3>{w.t}</h3>
          <p class="muted">{w.d}</p>
          {w.href && <a class="textlink" href={w.href}>{ar ? "تصفحي أحزمة الخصر" : "See the waist belts"}</a>}
        </li>
      ))}
    </ul>
    <p class="about-legal muted">{ar ? site.legalNameAr : site.legalNameEn} · {ar ? site.addressAr : site.addressEn}</p>
    <p><a class="btn" href={langPath(lang, "/contact/")}>{ar ? "تواصلي معنا" : "Contact us"}</a></p>
  </section>
</Base>
