---
// /about/: who Vicuna Designs is. Neutral theme (not a belts page); kept general so new activities fit in.
import Base from "../layouts/Base.astro";
import { langPath, site } from "../site.ts";
import { beltsUrl } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
const title = ar ? "من نحن | فيكونا ديزاينز" : "About us | Vicuna Designs";
const description = ar
  ? "فيكونا ديزاينز علامة مصرية مقرها القاهرة، تعمل في التصميم: من المنتجات المصنوعة يدويًا إلى تصميم المواقع الإلكترونية وبنائها."
  : "Vicuna Designs is an Egyptian brand based in Cairo working across design, from handmade products to designing and building websites.";
const work = ar
  ? [
      { t: "المنتجات والإكسسوارات", d: "نصمّم ونصنع بأيدينا، ونراجع كل قطعة قبل أن تصل إليكِ. أول ما بدأنا به: الأحزمة.", href: beltsUrl(lang) },
      { t: "تصميم المواقع وبناؤها", d: "نصمّم المواقع الإلكترونية ونبنيها بنفس الاهتمام بالتفاصيل: سريعة وواضحة وسهلة الاستخدام." },
    ]
  : [
      { t: "Products and accessories", d: "We design and make by hand and check every piece before it reaches you. Where we started: belts.", href: beltsUrl(lang) },
      { t: "Website design and building", d: "We design and build websites with the same care for detail: fast, clear and easy to use." },
    ];
---

<Base title={title} description={description} lang={lang} altPath={langPath(ar ? "en" : "ar", "/about/")} theme="neutral" image="/img/editorial/model-seated-1200.webp">
  <section class="wrap about-page">
    <header class="about-head">
      <p class="intro-kicker" lang="en">VICUNA DESIGNS</p>
      <h1>{ar ? "من نحن" : "About us"}</h1>
      <p class="lead">
        {ar
          ? "فيكونا ديزاينز علامة مصرية مقرها القاهرة، نعمل في التصميم بأشكاله المختلفة. نؤمن بأن العمل الجيد يبدأ من فكرة واضحة وتنفيذ متقن، ونهتم بالتفاصيل في كل ما نقدمه."
          : "Vicuna Designs is an Egyptian brand based in Cairo, working across design. We believe good work starts with a clear idea and careful execution, and we care about the details in everything we make."}
      </p>
    </header>
    <figure class="about-photo"><img src="/img/editorial/model-seated-1200.webp" srcset="/img/editorial/model-seated-640.webp 640w, /img/editorial/model-seated-1200.webp 1200w" sizes="(min-width: 900px) 60vw, 100vw" alt="" width="1200" height="1500" decoding="async" /></figure>
    <h2 class="about-h2">{ar ? "ماذا نفعل" : "What we do"}</h2>
    <ul class="about-work">
      {work.map((w) => (
        <li>
          <h3>{w.t}</h3>
          <p class="muted">{w.d}</p>
          {w.href && <a class="textlink" href={w.href}>{ar ? "تصفحي الأحزمة" : "See the belts"}</a>}
        </li>
      ))}
    </ul>
    <p class="about-legal muted">{ar ? site.legalNameAr : site.legalNameEn} · {ar ? site.addressAr : site.addressEn}</p>
    <p><a class="btn" href={langPath(lang, "/contact/")}>{ar ? "تواصلي معنا" : "Contact us"}</a></p>
  </section>
</Base>
