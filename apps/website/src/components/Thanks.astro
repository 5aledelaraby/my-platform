---
import Base from "../layouts/Base.astro";
import { site } from "../site.ts";
import { beltsUrl } from "../store.ts";
import type { Lang } from "../site.ts";

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === "ar";
const title = ar ? "تم استلام طلبك | فيكونا" : "Order received | Vicuna";
const wa = `https://wa.me/${site.whatsappInternational}`;
---

<Base title={title} description={title} lang={lang} altPath={ar ? "/en/thanks/" : "/thanks/"} noindex>
  <div class="wrap thanks">
    <h1>{ar ? "شكرًا لكِ" : "Thank you"}</h1>
    <p id="t-id-wrap" hidden>{ar ? "طلبك اتسجّل، ورقمه:" : "Your order is placed. Order number:"} <span class="order-id" id="t-id"></span></p>
    <p id="t-fallback" class="muted">{ar ? "لو الصفحة اتفتحت من غير طلب، تقدري تتصفحي أحزمة الخصر من تاني." : "If you opened this page without placing an order, you can keep browsing the belts."}</p>
    <p id="t-total" hidden></p>
    <div id="t-paypal" class="paypal-box" hidden>
      <p><b>{ar ? "خطوة أخيرة: ادفعي " : "One last step: pay "}<span id="t-usd" dir="ltr"></span>{ar ? " بـ PayPal" : " with PayPal"}</b></p>
      <div id="paypal-buttons"></div>
      <p id="t-paypal-msg" class="muted" role="status"></p>
      <p class="muted">{ar ? "طلبك متسجّل خلاص. لو الدفع ما نفعش، كلمينا على واتساب ونغيّر طريقة الدفع." : "Your order is already placed. If the payment does not work, message us on WhatsApp and we will change the payment method."}</p>
    </div>
    <p id="t-paid" hidden><b>{ar ? "تم الدفع بـ PayPal ✓" : "Paid with PayPal ✓"}</b></p>
    <p class="muted">{ar ? `هنتواصل معاكي لتأكيد الطلب، والتوصيل بياخد حوالي ${site.deliveryDays} أيام عمل.` : `We will contact you to confirm, and delivery takes about ${site.deliveryDays} working days.`}</p>
    <div class="hero-actions">
      <a class="btn" href={beltsUrl(lang)}>{ar ? "كملي تسوق" : "Keep shopping"}</a>
      <a class="btn ghost btn-wa" id="t-wa" href={wa} rel="noopener noreferrer">{ar ? "كلمينا على واتساب" : "Chat on WhatsApp"}</a>
    </div>
  </div>
</Base>

<style>
  .paypal-box { max-width: 420px; margin: 1.2rem auto; }
  #paypal-buttons { min-height: 48px; margin-block: .8rem; }
</style>

<script>
  import { formatEgp } from "@platform/commerce";
  import { startPaypal } from "../scripts/paypal.ts";
  import { track } from "../scripts/tracking.ts";
  const lang = document.documentElement.lang === "en" ? "en" : "ar";
  try {
    const raw = sessionStorage.getItem("vicuna-last-order");
    const order = raw
      ? (JSON.parse(raw) as { id?: string; paymentMethod?: string; totals?: { total?: number }; items?: Array<{ id: string; quantity: number; price: number }> })
      : null;
    if (order && typeof order.id === "string") {
      document.getElementById("t-id")!.textContent = order.id;
      document.getElementById("t-id-wrap")!.hidden = false;
      document.getElementById("t-fallback")!.hidden = true;
      if (typeof order.totals?.total === "number") {
        const t = document.getElementById("t-total")!;
        t.textContent = `${lang === "ar" ? "الإجمالي:" : "Total:"} ${formatEgp(order.totals.total)} ${lang === "ar" ? "جنيه" : "EGP"}`;
        t.hidden = false;
      }
      // Once per order, even if the thank-you page is reloaded. Without consent the event is dropped, and it is not
      // sent later either: the flag is set in both cases.
      const sent = `vicuna-tracked-${order.id}`;
      if (typeof order.totals?.total === "number" && !sessionStorage.getItem(sent)) {
        track({ type: "purchase", orderId: order.id, value: order.totals.total, items: Array.isArray(order.items) ? order.items : [] });
        sessionStorage.setItem(sent, "1");
      }
      if (order.paymentMethod === "paypal" && typeof order.totals?.total === "number") void startPaypal(order.id, order.totals.total, lang);
      const wa = document.getElementById("t-wa") as HTMLAnchorElement;
      const text = lang === "ar" ? `أهلاً فيكونا، رقم طلبي ${order.id}` : `Hello Vicuna, my order number is ${order.id}`;
      wa.href = `${wa.href.split("?")[0]}?text=${encodeURIComponent(text)}`;
    }
  } catch {
    /* storage unavailable: generic message stays */
  }
</script>
