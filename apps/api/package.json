{
  "name": "@platform/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Order API: validates a cart, recomputes prices on the server, stores the order in Cloudflare D1. Runs as a Cloudflare Worker.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply vicuna-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply vicuna-db --remote"
  },
  "dependencies": {
    "@platform/commerce": "workspace:*"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
